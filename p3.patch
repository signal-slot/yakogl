+            program.streams[s].shift = shift;
+            program.streams[s].multiplier =
+               (uint32_t)((((uint64_t)1 << (shift + 31u)) + (d - 1u)) / d);
+         }
+      }
       program.streams[s].address = st->address;
       program.streams[s].stride = st->stride;
       program.streams[s].num_elements = 1;
