@@ -85,6 +85,22 @@ static int vertex_program(uint64_t vs_usc_exec_offset, uint32_t vs_temps,
       if (st->dst_reg + dma_dw > vtxin_dw)
          vtxin_dw = st->dst_reg + dma_dw;
