/* SPDX-License-Identifier: Apache-2.0
 * SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
 *
 * Linker version script for the shared libraries: only the Khronos entry
 * points leave the library. Everything else (the GL core's internals, the
 * PowerVR backend, the OSAL, the shader table) stays local, so an application
 * cannot accidentally bind to a name that is not part of the API.
 *
 * The Rust archive is linked in whole (--whole-archive), so without this the
 * crate's own `#[no_mangle]` helpers and the driver's command generators
 * would all be exported too.
 */
YAKOGL_1 {
	global:
		gl[A-Z]*;                      /* OpenGL ES 2.0 */
		egl[A-Z]*;                     /* EGL 1.5 */
		gles_offline_shader_source;    /* gles_offline.h: the shader table */
	local:
		*;
};
