/*
 * The same sram0 as every Pi 5 image: 32 MiB from 0x200000, below 4 GiB.
 *
 * The HVS register block the probe reads is mapped in src/main.c with
 * device_map(); it has no node here.
 */
&sram0 {
	reg = <0x0 0x200000 0x2000000>;
};
