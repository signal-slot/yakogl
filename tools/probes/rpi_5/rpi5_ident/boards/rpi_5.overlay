/*
 * Zephyr's rpi_5 takes zephyr,sram from the SoC's sram0
 * (dts/arm64/broadcom/bcm2712.dtsi: 512 KiB at 0x200000, two address cells).
 * The Pi 5 GPU images carry their carve-out as statics, so sram0 is sized the
 * way the Pi 4 images do (driver/samples/zephyr/gl_test/boards/rpi_4b.overlay).
 * The identity probe needs no carve-out; it is linked into the same 32 MiB from
 * 0x200000 as tools/probes/rpi_5/rpi5_hello, so every Pi 5 image has one RAM.
 * Nothing in this overlay was run.
 */
&sram0 {
	reg = <0x0 0x200000 0x2000000>;
};
