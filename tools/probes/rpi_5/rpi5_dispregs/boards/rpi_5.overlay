/*
 * The same sram0 as every Pi 5 image: 32 MiB from 0x200000, below 4 GiB.
 *
 * The register blocks the probe reads (HVS, pixel valves, HDMI) and the
 * mailbox are mapped in src/main.c with device_map(); they have no node here.
 */
&sram0 {
	reg = <0x0 0x200000 0x2000000>;
};
