/*
 * The same sram0 as every Pi 5 image (tools/probes/rpi_5/rpi5_clear): 32 MiB
 * from 0x200000, below 4 GiB, so the mailbox's message buffer address fits
 * its 32-bit word. Zephyr's own mailbox driver stays disabled: the board
 * layer's rpi_mbox.c owns the mailbox. Nothing in this overlay was run.
 */
&sram0 {
	reg = <0x0 0x200000 0x2000000>;
};
