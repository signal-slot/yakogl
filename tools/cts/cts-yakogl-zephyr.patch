diff --git a/targets/yakogl-zephyr/yakogl-zephyr.cmake b/targets/yakogl-zephyr/yakogl-zephyr.cmake
new file mode 100644
index 000000000..7d74607dd
--- /dev/null
+++ b/targets/yakogl-zephyr/yakogl-zephyr.cmake
@@ -0,0 +1,36 @@
+#-------------------------------------------------------------------------
+# dEQP target for YakoGL on Zephyr (stage 1: static libraries only)
+#
+# The libraries are built with the Zephyr SDK compiler and the flags of a
+# configured Zephyr application (CONFIG_POSIX_API, full libstdc++), and linked
+# into a Zephyr image by driver/samples/zephyr/deqp. EGL and GLES2 are linked
+# directly: the entry points come from YakoGL's static library at the final
+# link, through dEQP's direct-link tables, and nothing is opened at run time.
+#-------------------------------------------------------------------------
+
+message("*** Using YakoGL Zephyr target")
+
+set(DEQP_TARGET_NAME	"YakoGL-Zephyr")
+set(DEQP_ZEPHYR		ON)
+
+set(DEQP_SUPPORT_GLES2	ON)
+set(DEQP_SUPPORT_EGL	ON)
+
+# Direct link: defining the library variables turns on DEQP_GLES2_DIRECT_LINK
+# and DEQP_EGL_DIRECT_LINK (CMakeLists.txt); the libraries themselves are
+# resolved by the Zephyr link, so they are named but empty here.
+set(GLES_ALLOW_DIRECT_LINK	ON)
+set(DEQP_GLES2_LIBRARIES	"")
+set(DEQP_EGL_LIBRARIES		"")
+
+# The platform port opens no library: DefaultLibrary(nullptr) uses the
+# direct-link table only.
+add_definitions(-DDEQP_EGL_LIBRARY_PATH=nullptr)
+add_definitions(-DDEQP_GLES2_LIBRARY_PATH=nullptr)
+
+set(TCUTIL_PLATFORM_SRCS
+	yakogl/tcuYakoGLPlatform.cpp
+	yakogl/tcuYakoGLPlatform.hpp
+	)
+
+set(DEQP_PLATFORM_LIBRARIES "")
