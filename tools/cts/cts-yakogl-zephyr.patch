diff --git a/framework/delibs/debase/deDefs.c b/framework/delibs/debase/deDefs.c
index e1eff67bf..68126158b 100644
--- a/framework/delibs/debase/deDefs.c
+++ b/framework/delibs/debase/deDefs.c
@@ -53,6 +53,9 @@ DE_STATIC_ASSERT(DE_PTR_SIZE == sizeof(void *));
 #include <stdio.h>
 #include <assert.h>
 #include <string.h>
+#if defined(__ZEPHYR__)
+#include <stdlib.h> /* abort() in deAssertFail */
+#endif
 
 #if (DE_OS == DE_OS_OSX) || (DE_OS == DE_OS_IOS) || defined(__FreeBSD__)
 #include <signal.h>
@@ -124,6 +127,11 @@ void deAssertFail(const char *reason, const char *file, int line)
     }
 #elif ((DE_OS == DE_OS_WIN32) && (DE_COMPILER == DE_COMPILER_CLANG || DE_COMPILER == DE_COMPILER_GCC))
     _assert(reason, file, line);
+#elif defined(__ZEPHYR__)
+    /* picolibc has __assert_func, not glibc's __assert_fail; abort() ends in
+     * the Zephyr fatal handler, which is where a failed assertion belongs */
+    fprintf(stderr, "Assertion '%s' failed at %s:%d\n", reason, file, line);
+    abort();
 #elif (DE_OS == DE_OS_OSX) || (DE_OS == DE_OS_IOS) || defined(__FreeBSD__)
     fprintf(stderr, "Assertion '%s' failed at %s:%d\n", reason, file, line);
     raise(SIGTRAP);
