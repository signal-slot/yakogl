+ *
+ * glmark2 is distributed in the hope that it will be useful, but WITHOUT ANY
+ * WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ * FOR A PARTICULAR PURPOSE.  See the GNU General Public License for more
+ * details.
+ *
+ * You should have received a copy of the GNU General Public License along with
+ * glmark2.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The main loop with YakoGL's picture value: for every scene that ran, one
+ * line on stderr after the scene's own result line (stdout is flushed first),
+ *
+ *   glmark2-picture: <scene info string>: WxH; probes c RRGGBBAA, tl RRGGBBAA,
+ *     tr RRGGBBAA, bl RRGGBBAA, br RRGGBBAA; crc16 XXXX, crc16q XXXX;
+ *     mean R G B; black yes|no                                    (one line)
+ *   glmark2-picture: <scene info string>: absent (the readback failed)
+ *
+ * read with glReadPixels after the scene's last update() and before its last
+ * swap. The probes, the 40x30 grid, the crcs and the mean are the code of
+ * YakoGL's glmark2 board images (driver/samples/zephyr/glmark2/src/main.cpp,
+ * capture_picture; the format is driver/docs/glmark2.md, "The picture
+ * value"); change them together.
+ *
+ * With GLMARK2_FB=1 in the environment the scene's frame is also printed on
+ * stderr, at the same place, as the frame dump of driver/docs/glmark2.md
+ * "The frame dump" (the code and format of tools/cts/glmark2-host-ref.patch,
+ * which tools/cts/glmark2-fb.py decodes):
+ *
+ *   glmark2-fb: <scene info string> WxH begin
+ *   glmark2-fb: <y> <crc16 of the row's RGB, hex> <base64 of the row's RGB888>
+ *   glmark2-fb: end crc32 <hex>
+ *
+ * It is off unless the variable is exactly "1"; then each scene prints its
+ * whole window (about 1.9 MB at 800x600), so name one scene or expect a log
+ * of that size per scene.
+ */
+#ifndef GLMARK2_MAIN_LOOP_PICTURE_H_
+#define GLMARK2_MAIN_LOOP_PICTURE_H_
+
+#include "main-loop.h"
+#include "canvas.h"
+#include "gl-headers.h"
+#include "scene.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+class MainLoopPicture : public MainLoop
+{
+public:
+    MainLoopPicture(Canvas &canvas, const std::vector<Benchmark *> &benchmarks) :
+        MainLoop(canvas, benchmarks) {}
+
+    /* MainLoop::draw with the scene's last frame read back before its swap */
+    void draw() override
+    {
+        canvas_.clear();
+
+        scene_->draw();
+        scene_->update();
+
+        if (!scene_->running() && scene_setup_status_ == SceneSetupStatusSuccess)
+            capture(canvas_.width(), canvas_.height());
+
+        canvas_.update();
+    }
+
+    void before_scene_setup() override
+    {
+        picture_ = Picture();
+    }
+
+    void log_scene_result() override
+    {
+        MainLoop::log_scene_result();
+        if (scene_setup_status_ != SceneSetupStatusSuccess)
+            return;
+        char text[256];
+        picture_text(text, sizeof(text));
+        std::fflush(stdout);
+        std::fprintf(stderr, "glmark2-picture: %s: %s\n", scene_->info_string().c_str(), text);
+        std::fflush(stderr);
+    }
+
+private:
+    struct Picture {
+        static constexpr int GRID_X = 40, GRID_Y = 30, PROBES = 5;
+        bool valid = false;
+        int width = 0, height = 0;
+        uint32_t probe[PROBES] = {}; /* RGBA, R in the top byte */
+        uint16_t crc = 0;            /* crc16 of the grid's RGB, exact */
+        uint16_t crc_q = 0;          /* the same with each channel >> 4 */
+        uint32_t mean[3] = {};       /* mean R, G, B over the grid */
+        bool black = true;           /* every sampled pixel has R = G = B = 0 */
+    };
+
+    /* CRC-16/CCITT-FALSE (poly 0x1021, init 0xffff), one byte at a time. */
+    static uint16_t crc16_byte(uint16_t crc, uint8_t b)
+    {
+        crc ^= static_cast<uint16_t>(b << 8);
+        for (int i = 0; i < 8; i++) {
+            crc = (crc & 0x8000u) ? static_cast<uint16_t>((crc << 1) ^ 0x1021u)
+                                  : static_cast<uint16_t>(crc << 1);
+        }
+        return crc;
+    }
+
+    static uint32_t crc32_update(uint32_t crc, const uint8_t *p, size_t n)
+    {
+        while (n--) {
+            crc ^= *p++;
+            for (int i = 0; i < 8; i++)
+                crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+        }
+        return crc;
+    }
+
+    /* GLMARK2_FB=1: the frame dump (off for unset and for any other value) */
+    static bool frame_dump_wanted()
+    {
+        const char *v = std::getenv("GLMARK2_FB");
+        return v && std::strcmp(v, "1") == 0;
+    }
+
+    /* The scene's last frame as glmark2-host-ref.patch's yk_frame_dump prints
+     * it: top row first, crc16 per row, crc32 over all rows' RGB. A failed
+     * readback prints nothing (the picture line then says absent). */
+    void frame_dump(int w, int h)
+    {
+        static const char b64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+        std::vector<uint8_t> rgba(static_cast<size_t>(w) * h * 4u, 0);
+        while (glGetError() != GL_NO_ERROR) {
+        }
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+        if (glGetError() != GL_NO_ERROR)
+            return;
+
+        std::fflush(stdout);
+        std::fprintf(stderr, "\nglmark2-fb: %s %dx%d begin\n", scene_->info_string().c_str(), w, h);
+        std::vector<uint8_t> rgb(static_cast<size_t>(w) * 3u);
+        std::string text;
+        uint32_t crc = 0xffffffffu;
+        for (int y = 0; y < h; y++) {
+            /* glReadPixels counts rows from the bottom */
+            const uint8_t *src = &rgba[static_cast<size_t>(h - 1 - y) * w * 4u];
+            for (int x = 0; x < w; x++)
+                for (int c = 0; c < 3; c++)
+                    rgb[static_cast<size_t>(x) * 3u + c] = src[static_cast<size_t>(x) * 4u + c];
+            uint16_t c16 = 0xffffu;
+            for (uint8_t b : rgb)
+                c16 = crc16_byte(c16, b);
+            crc = crc32_update(crc, rgb.data(), rgb.size());
+            text.clear();
+            for (size_t i = 0; i < rgb.size(); i += 3) {
+                const size_t left = rgb.size() - i;
+                const uint32_t v = static_cast<uint32_t>(rgb[i]) << 16 |
+                                   (left > 1 ? static_cast<uint32_t>(rgb[i + 1]) << 8 : 0u) |
+                                   (left > 2 ? rgb[i + 2] : 0u);
+                text += b64[v >> 18 & 63u];
+                text += b64[v >> 12 & 63u];
+                text += left > 1 ? b64[v >> 6 & 63u] : '=';
+                text += left > 2 ? b64[v & 63u] : '=';
+            }
+            std::fprintf(stderr, "glmark2-fb: %d %04x %s\n", y, static_cast<unsigned>(c16), text.c_str());
+        }
+        std::fprintf(stderr, "glmark2-fb: end crc32 %08x\n", static_cast<unsigned>(~crc));
+        std::fflush(stderr);
+    }
+
+    /* row y (0 is the top) of the current framebuffer as RGBA bytes */
+    static bool picture_row(int w, int h, int y, std::vector<uint8_t> &row)
+    {
+        row.assign(static_cast<size_t>(w) * 4u, 0);
+        glReadPixels(0, h - 1 - y, w, 1, GL_RGBA, GL_UNSIGNED_BYTE, row.data());
+        return glGetError() == GL_NO_ERROR;
+    }
+
+    void capture(int w, int h)
+    {
+        Picture p;
+        p.width = w;
+        p.height = h;
+        picture_ = p;
+        if (w < Picture::GRID_X || h < Picture::GRID_Y)
+            return;
+        if (frame_dump_wanted())
+            frame_dump(w, h);
+        std::vector<uint8_t> row;
+        /* an error the scene left is not the readback's */
+        while (glGetError() != GL_NO_ERROR) {
+        }
+        /* the probes: the centre, then the four quarter points */
+        const int px[Picture::PROBES] = {w / 2, w / 4, w * 3 / 4, w / 4, w * 3 / 4};
+        const int py[Picture::PROBES] = {h / 2, h / 4, h / 4, h * 3 / 4, h * 3 / 4};
+        for (int i = 0; i < Picture::PROBES; i++) {
+            if (!picture_row(w, h, py[i], row))
+                return;
+            const uint8_t *q = &row[static_cast<size_t>(px[i]) * 4u];
+            p.probe[i] = static_cast<uint32_t>(q[0]) << 24 | static_cast<uint32_t>(q[1]) << 16 |
+                         static_cast<uint32_t>(q[2]) << 8 | q[3];
+            p.black = p.black && !q[0] && !q[1] && !q[2];
+        }
+        /* the grid: the centres of 40x30 equal cells, row by row, left to right */
+        uint16_t crc = 0xffffu, crc_q = 0xffffu;
+        uint64_t sum[3] = {};
+        for (int gy = 0; gy < Picture::GRID_Y; gy++) {
+            if (!picture_row(w, h, (2 * gy + 1) * h / (2 * Picture::GRID_Y), row))
+                return;
+            for (int gx = 0; gx < Picture::GRID_X; gx++) {
+                const uint8_t *q = &row[static_cast<size_t>((2 * gx + 1) * w / (2 * Picture::GRID_X)) * 4u];
+                for (int c = 0; c < 3; c++) {
+                    crc = crc16_byte(crc, q[c]);
+                    crc_q = crc16_byte(crc_q, static_cast<uint8_t>(q[c] >> 4));
+                    sum[c] += q[c];
+                }
+                p.black = p.black && !q[0] && !q[1] && !q[2];
+            }
+        }
+        p.crc = crc;
+        p.crc_q = crc_q;
+        for (int c = 0; c < 3; c++)
+            p.mean[c] = static_cast<uint32_t>(sum[c] / (Picture::GRID_X * Picture::GRID_Y));
+        p.valid = true;
+        picture_ = p;
+    }
+
+    /* the picture line's text after "glmark2-picture: <scene>: " */
+    void picture_text(char *out, size_t n) const
+    {
+        const Picture &p = picture_;
+        if (!p.valid) {
+            std::snprintf(out, n, "absent (the readback failed)");
+            return;
+        }
+        std::snprintf(out, n,
+                      "%dx%d; probes c %08x, tl %08x, tr %08x, bl %08x, br %08x; crc16 %04x, crc16q %04x; "
+                      "mean %u %u %u; black %s",
+                      p.width, p.height, static_cast<unsigned>(p.probe[0]), static_cast<unsigned>(p.probe[1]),
+                      static_cast<unsigned>(p.probe[2]), static_cast<unsigned>(p.probe[3]),
+                      static_cast<unsigned>(p.probe[4]), static_cast<unsigned>(p.crc),
+                      static_cast<unsigned>(p.crc_q), static_cast<unsigned>(p.mean[0]),
+                      static_cast<unsigned>(p.mean[1]), static_cast<unsigned>(p.mean[2]),
+                      p.black ? "yes" : "no");
+    }
+
+    Picture picture_;
+};
+
+#endif /* GLMARK2_MAIN_LOOP_PICTURE_H_ */
