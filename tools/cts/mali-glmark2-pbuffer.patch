+
+#include "native-state-pbuffer.h"
+#include "log.h"
+
+bool
+NativeStatePbuffer::init_display()
+{
+    signal(SIGINT, &NativeStatePbuffer::quit_handler);
+    signal(SIGTERM, &NativeStatePbuffer::quit_handler);
+    return true;
+}
+
+/* EGL_DEFAULT_DISPLAY */
+void*
+NativeStatePbuffer::display()
+{
+    return nullptr;
+}
+
+bool
+NativeStatePbuffer::create_window(WindowProperties const& properties)
+{
+    if (properties.fullscreen) {
+        Log::error("Fullscreen not supported (a pbuffer has the size it is given)\n");
+        return false;
+    }
+
+    if (properties.width <= 0 || properties.height <= 0) {
+        Log::error("Invalid surface size\n");
+        return false;
+    }
+    properties_ = WindowProperties(properties.width, properties.height, false, 0, {});
+    window_.width = properties.width;
+    window_.height = properties.height;
+
+    return true;
+}
+
+void*
+NativeStatePbuffer::window(WindowProperties& properties)
+{
+    properties = properties_;
+    return window_.width > 0 ? &window_ : nullptr;
+}
+
+void
+NativeStatePbuffer::visible(bool /*v*/)
+{
+}
+
+volatile std::sig_atomic_t NativeStatePbuffer::should_quit_(false);
+
+void
+NativeStatePbuffer::quit_handler(int /*signo*/)
+{
+    should_quit_ = true;
+}
+
+bool
+NativeStatePbuffer::should_quit()
+{
+    return should_quit_;
+}
+
+void
+NativeStatePbuffer::flip()
+{
+}
