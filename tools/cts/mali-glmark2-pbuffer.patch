+/*
+ * The pbuffer native system: no window system at all. The "window" is the
+ * size of an EGL pbuffer surface, which gl-state-egl.cpp creates with
+ * eglCreatePbufferSurface on the default display (GLMARK2_USE_PBUFFER), for
+ * an EGL that offers pbuffer surfaces only (YakoGL's Mali pair,
+ * tools/mali/panthor-gles). Unlike the null system it needs neither
+ * EGL_MESA_platform_surfaceless nor a surfaceless context, and it renders
+ * on-screen in glmark2's sense: into the surface's own colour buffer, which
+ * glReadPixels reads and eglSwapBuffers submits.
+ */
+#ifndef GLMARK2_NATIVE_STATE_PBUFFER_H_
+#define GLMARK2_NATIVE_STATE_PBUFFER_H_
+
+#include "native-state.h"
+#include <csignal>
+
+/* What window() hands gl-state-egl.cpp as the native window. */
+struct PbufferWindow
+{
+    int width;
+    int height;
+};
+
+class NativeStatePbuffer : public NativeState
+{
+public:
+    bool init_display() override;
+    void* display() override;
+    bool create_window(WindowProperties const& properties) override;
+    void* window(WindowProperties& properties) override;
+    void visible(bool v) override;
+    bool should_quit() override;
+    void flip() override;
+
+private:
+    static void quit_handler(int signum);
+    static volatile std::sig_atomic_t should_quit_;
+
+    WindowProperties properties_;
+    PbufferWindow window_ = {0, 0};
+};
+
+#endif /* GLMARK2_NATIVE_STATE_PBUFFER_H_ */
