+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ *//*!
+ * \file
+ * \brief YakoGL platform port.
+ *//*--------------------------------------------------------------------*/
+
+#include "tcuYakoGLPlatform.hpp"
+
+#include "egluGLContextFactory.hpp"
+#include "egluNativeDisplay.hpp"
+#include "eglwEnums.hpp"
+#include "eglwLibrary.hpp"
+
+#if !defined(DEQP_EGL_LIBRARY_PATH)
+#define DEQP_EGL_LIBRARY_PATH "libEGL.so.1"
+#endif
+
+namespace tcu
+{
+namespace yakogl
+{
+
+using namespace eglw;
+
+namespace
+{
+
+/* YakoGL's eglGetDisplay() takes EGL_DEFAULT_DISPLAY and nothing else, so the
+ * display advertises the legacy capability only. libEGL is opened by SONAME:
+ * a board image carries libEGL.so.1, not the libEGL.so development symlink. */
+class Display : public eglu::NativeDisplay
+{
+public:
+    static const Capability CAPABILITIES = CAPABILITY_GET_DISPLAY_LEGACY;
+
+    Display(void) : eglu::NativeDisplay(CAPABILITIES), m_library(DEQP_EGL_LIBRARY_PATH)
+    {
+    }
+
+    EGLNativeDisplayType getLegacyNative(void)
+    {
+        return EGL_DEFAULT_DISPLAY;
+    }
+
+    const eglw::Library &getLibrary(void) const
+    {
+        return m_library;
+    }
+
+private:
+    eglw::DefaultLibrary m_library;
+};
+
+/* No window and no pixmap factory is registered. eglu::GLContextFactory turns
+ * that into a NotSupportedError for the window and pixmap surface types and
+ * uses eglCreatePbufferSurface() for --deqp-surface-type=pbuffer. */
+class DisplayFactory : public eglu::NativeDisplayFactory
+{
+public:
+    DisplayFactory(void) : eglu::NativeDisplayFactory("yakogl", "YakoGL EGL default display", Display::CAPABILITIES)
+    {
+    }
+
+    eglu::NativeDisplay *createDisplay(const EGLAttrib *attribList) const
+    {
+        DE_UNREF(attribList);
+        return new Display();
+    }
+};
+
+} // namespace
+
+Platform::Platform(void)
+{
+    m_nativeDisplayFactoryRegistry.registerFactory(new DisplayFactory());
+    m_contextFactoryRegistry.registerFactory(new eglu::GLContextFactory(m_nativeDisplayFactoryRegistry));
+}
+
+Platform::~Platform(void)
+{
+}
+
+} // namespace yakogl
+} // namespace tcu
+
+tcu::Platform *createPlatform(void)
+{
+    return new tcu::yakogl::Platform();
+}
