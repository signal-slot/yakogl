+#ifndef _TCUYAKOGLPLATFORM_HPP
+#define _TCUYAKOGLPLATFORM_HPP
+/*-------------------------------------------------------------------------
+ * drawElements Quality Program Tester Core
+ * ----------------------------------------
+ *
+ * Copyright (c) 2026 Signal Slot, Inc.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ *
+ *//*!
+ * \file
+ * \brief YakoGL platform port.
+ *
+ * YakoGL is an OpenGL ES 2.0 + minimal EGL library with no window system.
+ * eglGetDisplay() accepts only EGL_DEFAULT_DISPLAY, there are no platform
+ * extensions, and a window surface needs a native window struct whose pages
+ * the caller owns. A test process cannot allocate those, so this port offers
+ * pbuffer surfaces only: it registers a native display factory with no window
+ * and no pixmap factory. Run dEQP with --deqp-surface-type=pbuffer.
+ *//*--------------------------------------------------------------------*/
+
+#include "tcuDefs.hpp"
+#include "tcuPlatform.hpp"
+#include "gluPlatform.hpp"
+#include "egluPlatform.hpp"
+
+namespace tcu
+{
+namespace yakogl
+{
+
+class Platform : public tcu::Platform, private glu::Platform, private eglu::Platform
+{
+public:
+    Platform(void);
+    virtual ~Platform(void);
+
+    virtual const glu::Platform &getGLPlatform(void) const
+    {
+        return static_cast<const glu::Platform &>(*this);
+    }
+
+    virtual const eglu::Platform &getEGLPlatform(void) const
+    {
+        return static_cast<const eglu::Platform &>(*this);
+    }
+};
+
+} // namespace yakogl
+} // namespace tcu
+
+#endif // _TCUYAKOGLPLATFORM_HPP
diff --git a/targets/yakogl/yakogl.cmake b/targets/yakogl/yakogl.cmake
new file mode 100644
index 0000000..fdaa82d
--- /dev/null
+++ b/targets/yakogl/yakogl.cmake
@@ -0,0 +1,31 @@
+#-------------------------------------------------------------------------
+# dEQP target for YakoGL
+#
+# YakoGL is a source-compatible OpenGL ES 2.0 + minimal EGL library. Its EGL
+# has no platform extensions and no window system: eglGetDisplay() only takes
+# EGL_DEFAULT_DISPLAY, and the only surface a test process can create for
+# itself is a pbuffer. So this target builds the EGL platform port in
+# framework/platform/yakogl, which registers a pbuffer-only native display
+# factory, and links no GL or EGL library at build time: libEGL.so.1 and
+# libGLESv2.so.2 are opened at run time with deDynamicLibrary.
+#-------------------------------------------------------------------------
+
+message("*** Using YakoGL target")
+
+set(DEQP_TARGET_NAME	"YakoGL")
+
+set(DEQP_SUPPORT_GLES2	ON)
+set(DEQP_SUPPORT_EGL	ON)
+
+# Run-time loading: leave DEQP_GLES2_LIBRARIES and DEQP_EGL_LIBRARIES empty.
+# Name the SONAMEs YakoGL is packaged under, not the "libGLESv2.so" /
+# "libEGL.so" development symlinks, which a board image need not carry.
+add_definitions(-DDEQP_GLES2_LIBRARY_PATH="libGLESv2.so.2")
+add_definitions(-DDEQP_EGL_LIBRARY_PATH="libEGL.so.1")
+
+set(TCUTIL_PLATFORM_SRCS
+	yakogl/tcuYakoGLPlatform.cpp
+	yakogl/tcuYakoGLPlatform.hpp
+	)
+
+set(DEQP_PLATFORM_LIBRARIES	${CMAKE_DL_LIBS})
