row 3  img4-abcd1234  (1 case)
  filter: dEQP-GLES2.functional.state_query.*,dEQP-GLES2.functional.negative_api.*
  dEQP-GLES2.functional.negative_api.texture.generatemipmap_npot_wdt_hgt
TREE_ROWS=1,3
commands:
  TREE_ROWS=1,3 $SW/tools/cts/am62p-deqp-images.sh $SW/tools/cts/testdata/rows-for-cases/am62p-tree.txt <img> abcd1234 > <img>/build.out
  TREE_IMAGE_DIR=<img> TREE_TAG=abcd1234 TREE_ROWS=1,3 $SW/tools/board.sh am62p tree $SW/tools/cts/testdata/rows-for-cases/am62p-tree.txt <rec>
