# A fake scp for tools/cts/mali-glmark2-selftest.sh: a cp -r with every
# <host>:<path> taken as <path> of this host (the fake board's home is a real
# directory, see the fake ssh beside it). Logged to FAKE_LOG; fails while
# FAKE_BOARD/down exists.
echo "scp $*" >> "${FAKE_LOG:?}"
args=()
while [ $# -gt 0 ]; do
  case $1 in
    -o | -i | -P | -F) shift 2 ;;
    -*) shift ;;
    /* | ./*) args+=("$1"); shift ;;
    *:*)
      [ ! -e "$FAKE_BOARD/down" ] || { echo "scp: lost connection" >&2; exit 1; }
      args+=("${1#*:}"); shift ;;
    *) args+=("$1"); shift ;;
  esac
done
cp -r "${args[@]}"
