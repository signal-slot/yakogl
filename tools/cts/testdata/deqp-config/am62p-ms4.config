# Fixture: the resolved zephyr/.config of the AM62P multisample image
# (tools/cts/am62p-ms4-tree.txt's MS4 row: -DCONFIG_DEQP_GL_CONFIG_NAME=
# "rgba8888d24s8ms4"). check-deqp-images.py --config <this> --ms4 must PASS
# it; the same file without --ms4 is bad-sweep-ms4-name.config's rule.
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_POWERVR=y
CONFIG_YAKOGL_DRV_GPU_PVR=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
CONFIG_YAKOGL_SHADERC_SCRATCH_BYTES=4194304
CONFIG_YAKOGL_SHADERC_KEEP_BYTES=1048576
CONFIG_YAKOGL_REPORT_ES2=y
CONFIG_YAKOGL_TEST_KNOBS=y
CONFIG_DEQP_REPORT_ES2=y
CONFIG_DEQP_TEST_KNOBS=y
CONFIG_DEQP_PVR_NATIVE_CUBE=-1
# CONFIG_DEQP_ECHO_QPA is not set
CONFIG_DEQP_GL_CONFIG_NAME="rgba8888d24s8ms4"
CONFIG_DEQP_CASE="dEQP-GLES2.functional.multisample.*"
CONFIG_DEQP_CASE_TABLE=""
CONFIG_DEQP_SURFACE_SIZE=256
CONFIG_YAKOGL_AM62P_RTI_SELF_ARM=y
CONFIG_YAKOGL_AM62P_WDT_SECONDS=600
# CONFIG_SOC_AM62PX_A53_FEED_INHERITED_WDT is not set
CONFIG_SOC_AM62PX_A53_BOOT_MARKER=y
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_MAIN_STACK_SIZE=1048576
CONFIG_MAX_XLAT_TABLES=128
CONFIG_KERNEL_VM_SIZE=0x20000000
CONFIG_YAKOGL_SAMPLE_HOLD_SECONDS=20
CONFIG_REBOOT=y
