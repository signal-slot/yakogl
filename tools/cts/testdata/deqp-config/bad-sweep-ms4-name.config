# Fixture (AM62P sweep image, broken): the sweep image resolved the
# multisample render config — the DEQP_GL_CONFIG_NAME environment the
# Kconfig default reads was set when the image was built, which is why
# tools/cts/am62p-deqp-images.sh unsets it and passes the name explicitly.
# A sweep image runs on the default (single-sampled) config.
# check-deqp-images.py --config <this> (no --ms4) must FAIL naming
# DEQP_GL_CONFIG_NAME.
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_POWERVR=y
CONFIG_SAFEUI_GPU_PVR=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
CONFIG_YAKOGL_REPORT_ES2=y
CONFIG_DEQP_REPORT_ES2=y
CONFIG_DEQP_GL_CONFIG_NAME="rgba8888d24s8ms4"
CONFIG_DEQP_CASE="dEQP-GLES2.functional.texture.*"
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_KERNEL_VM_SIZE=0x20000000
