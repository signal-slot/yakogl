# Fixture (AM62P image, broken for a GLES2 run): the dEQP-GLES3 build —
# tools/cts/am62p-deqp-images.sh with DEQP_MODULE=gles3 passes
# -DCONFIG_DEQP_REPORT_ES2=n, which drops the select and leaves the library
# reporting ES 3.0. That image is legitimate, and the builder skips this
# check for it; fed to the check anyway, it must FAIL naming
# DEQP_REPORT_ES2 (the sample's own ES 2.0 switch is gone from the build).
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_POWERVR=y
CONFIG_SAFEUI_GPU_PVR=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
CONFIG_YAKOGL_REPORT_ES2=y
# CONFIG_DEQP_REPORT_ES2 is not set
CONFIG_DEQP_GL_CONFIG_NAME=""
CONFIG_DEQP_CASE="dEQP-GLES2.functional.texture.*"
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_KERNEL_VM_SIZE=0x20000000
