# Fixture (AM62P image, broken for both runs): what -DCONFIG_DEQP_REPORT_ES2=n
# alone resolves to (tools/cts/am62p-deqp-images.sh DEQP_MODULE=gles3 at the
# time of writing). It drops the select, but YAKOGL_REPORT_ES2 is default y,
# so the library still reports ES 2.0: not a dEQP-GLES3 image either. A GLES3
# image also needs -DCONFIG_YAKOGL_REPORT_ES2=n (bad-report-es3.config is that
# resolution). The default check must FAIL naming DEQP_REPORT_ES2, and
# --gles3 must FAIL naming YAKOGL_REPORT_ES2.
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_POWERVR=y
CONFIG_YAKOGL_DRV_GPU_PVR=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
CONFIG_YAKOGL_REPORT_ES2=y
# CONFIG_DEQP_REPORT_ES2 is not set
CONFIG_DEQP_GL_CONFIG_NAME=""
CONFIG_DEQP_CASE="dEQP-GLES2.functional.texture.*"
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_KERNEL_VM_SIZE=0x20000000
