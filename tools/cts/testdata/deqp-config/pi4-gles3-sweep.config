# Fixture: the resolved zephyr/.config of a Raspberry Pi 4 dEQP-GLES3 sweep
# image (driver/samples/zephyr/v3d_deqp on rpi_4b, built by
# tools/cts/pi4-deqp-images.sh with DEQP_MODULE=gles3: -DDEQP_MODULE=gles3
# -DCONFIG_DEQP_REPORT_ES2=n -DCONFIG_YAKOGL_REPORT_ES2=n, so both REPORT_ES2
# symbols resolve off and the context reports OpenGL ES 3.0).
# check-deqp-images.py --config --gles3 must PASS this, and without --gles3
# must FAIL it naming YAKOGL_REPORT_ES2 (cts-selftest.sh check 17).
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_V3D=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
CONFIG_YAKOGL_SHADERC_SCRATCH_BYTES=4194304
CONFIG_YAKOGL_SHADERC_KEEP_BYTES=1048576
# CONFIG_YAKOGL_REPORT_ES2 is not set
CONFIG_YAKOGL_TEST_KNOBS=y
CONFIG_YAKOGL_V3D_CARVEOUT_BYTES=50331648
CONFIG_YAKOGL_V3D_TILED_COPIES_BYTES=16777216
# CONFIG_DEQP_REPORT_ES2 is not set
CONFIG_DEQP_TEST_KNOBS=y
CONFIG_DEQP_GL_CONFIG_NAME=""
CONFIG_DEQP_CASE="dEQP-GLES3.functional.state_query.*"
CONFIG_DEQP_CASE_TABLE=""
CONFIG_DEQP_SURFACE_SIZE=256
CONFIG_V3D_DEQP_LIFETIME_S=240
CONFIG_V3D_DEQP_PHOTO_S=30
# CONFIG_V3D_DEQP_QPA_UART is not set
CONFIG_PRINTK=y
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_MAIN_STACK_SIZE=1048576
