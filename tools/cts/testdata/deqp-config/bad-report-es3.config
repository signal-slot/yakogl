# Fixture (AM62P sweep image, broken): the image reports OpenGL ES 3.0 —
# both REPORT_ES2 symbols resolved off, as a build that says
# CONFIG_YAKOGL_REPORT_ES2=n leaves them. dEQP-GLES2 judges an ES 2.0
# context, so a GLES2 image must not be this.
# check-deqp-images.py --config must FAIL naming YAKOGL_REPORT_ES2.
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_POWERVR=y
CONFIG_SAFEUI_GPU_PVR=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
# CONFIG_YAKOGL_REPORT_ES2 is not set
# CONFIG_DEQP_REPORT_ES2 is not set
CONFIG_DEQP_GL_CONFIG_NAME=""
CONFIG_DEQP_CASE="dEQP-GLES2.functional.texture.*"
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_KERNEL_VM_SIZE=0x20000000
