# Fixture (AM62P sweep image, broken): the compiler is on, but the
# precompiled tier was switched on in front of it — a conformance image runs
# the in-process compiler for every shader, so no table may be linked.
# check-deqp-images.py --config must FAIL naming YAKOGL_PRECOMPILED_SHADERS.
CONFIG_YAKOGL=y
CONFIG_YAKOGL_GPU_POWERVR=y
CONFIG_SAFEUI_GPU_PVR=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
CONFIG_YAKOGL_PRECOMPILED_SHADERS=y
CONFIG_YAKOGL_PRECOMPILED_APPS=""
CONFIG_YAKOGL_PRECOMPILED_LIST=""
CONFIG_YAKOGL_SHADERC_SCRATCH_BYTES=4194304
CONFIG_YAKOGL_SHADERC_KEEP_BYTES=1048576
CONFIG_YAKOGL_REPORT_ES2=y
CONFIG_DEQP_REPORT_ES2=y
CONFIG_DEQP_GL_CONFIG_NAME=""
CONFIG_DEQP_CASE="dEQP-GLES2.functional.texture.*"
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=67108864
CONFIG_KERNEL_VM_SIZE=0x20000000
