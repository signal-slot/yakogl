# Fixture: the resolved zephyr/.config of an i.MX8MP dEQP-GLES2 image
# (driver/samples/zephyr/deqp on verdin_imx8mp/mimx8ml8/a53, the one image
# of tools/cts/imx8mp-full-tree.txt, whose rows the run-time selector picks
# from CONFIG_DEQP_CASE_TABLE). check-deqp-images.py --config must PASS this
# (cts-selftest.sh check 17).
CONFIG_YAKOGL=y
# CONFIG_SAFEUI_GPU_PVR is not set
CONFIG_SAFEUI_GPU_VIVANTE=y
CONFIG_YAKOGL_GPU_VIVANTE=y
CONFIG_YAKOGL_SHADERC_ONLINE=y
# CONFIG_YAKOGL_SHADERC_OFFLINE is not set
# CONFIG_YAKOGL_SHADERC_PRECOMPILED_ONLY is not set
# CONFIG_YAKOGL_PRECOMPILED_SHADERS is not set
CONFIG_YAKOGL_SHADERC_SCRATCH_BYTES=4194304
CONFIG_YAKOGL_SHADERC_KEEP_BYTES=1048576
CONFIG_YAKOGL_REPORT_ES2=y
CONFIG_YAKOGL_TEST_KNOBS=y
CONFIG_DEQP_REPORT_ES2=y
CONFIG_DEQP_TEST_KNOBS=y
# CONFIG_DEQP_SNVS_ADDRESS is not set
CONFIG_DEQP_PROBE_POINTS=""
CONFIG_DEQP_GL_CONFIG_NAME=""
CONFIG_DEQP_CASE="dEQP-GLES2.info.*"
CONFIG_DEQP_CASE_TABLE="dEQP-GLES2.info.*;dEQP-GLES2.functional.fbo.*"
CONFIG_DEQP_SURFACE_SIZE=256
# board lines (boards/verdin_imx8mp_mimx8ml8_a53.conf)
CONFIG_YAKOGL_GC_BOARD=y
CONFIG_GC_BOARD_WDOG_SELF_ARM=y
CONFIG_GC_BOARD_WDOG_SECONDS=600
# CONFIG_GC_COMMON_PANEL_CONSOLE is not set
# CONFIG_GC_SAMPLE_FATAL_HANDLER is not set
# CONFIG_UART_CONSOLE is not set
CONFIG_COMMON_LIBC_MALLOC_ARENA_SIZE=167772160
CONFIG_MAIN_STACK_SIZE=1048576
CONFIG_KERNEL_VM_SIZE=0x20000000
CONFIG_PM_CPU_OPS=y
CONFIG_PM_CPU_OPS_PSCI=y
CONFIG_REBOOT=y
