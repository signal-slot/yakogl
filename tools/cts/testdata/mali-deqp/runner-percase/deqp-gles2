#
# A fake deqp-gles2 for tools/cts/mali-deqp-run-selftest.sh. For each case of
# --deqp-caselist-file it prints dEQP's "Test case '<case>'.." line on stdout
# and, as FAKE_SCENARIO (a "<case><TAB><action>" table) says, the library's
# per-draw line on stderr, interleaved as the real pair prints them:
#   refuse  yakogl-mali-refusal: -95 NOT_BUILT_BLEND_SHADER ...
#   errno   yakogl-mali-refusal: -12 errno
# and any other case prints none. A third column of the scenario ("info"
# text) is written as the case's shader program <InfoLog> in the .qpa, with
# the status Fail (the extractor's input: refusals.tsv). It writes a minimal .qpa with every case
# as its action says (Pass, Fail for refuse, ResourceError for errno), and
# the "yakogl-mali: loaded" and "yakogl-mali-exit" stderr lines the runner
# looks for. Each line is followed by a pause: the runner merges stdout and
# stderr through two pipes, and real dEQP spends milliseconds on a case.
list= log=
for a; do
  case $a in
    --deqp-caselist-file=*) list=${a#*=} ;;
    --deqp-log-filename=*) log=${a#*=} ;;
  esac
done
[ -n "$list" ] && [ -n "$log" ] || { echo "fake deqp-gles2: no case list or log" >&2; exit 2; }
action() { awk -F'\t' -v c="$1" '$1 == c { print $2; exit }' "${FAKE_SCENARIO:-/dev/null}"; }
infolog() { awk -F'\t' -v c="$1" '$1 == c { print $3; exit }' "${FAKE_SCENARIO:-/dev/null}"; }
echo "yakogl-mali: loaded libGLESv2.so.2 (fixture build)" >&2
sleep 0.2
printf '#sessionInfo releaseName fixture\n#beginSession\n' > "$log"
while read -r c; do
  [ -n "$c" ] || continue
  echo "Test case '$c'.."
  sleep 0.2
  st=Pass
  case $(action "$c") in
    refuse) echo "yakogl-mali-refusal: -95 NOT_BUILT_BLEND_SHADER: a blend shader other than a constant colour's is not built yet" >&2; st=Fail ;;
    errno) echo "yakogl-mali-refusal: -12 errno" >&2; st=ResourceError ;;
    info) st=Fail ;;
  esac
  sleep 0.2
  echo "  $st ($st)"
  sleep 0.2
  {
    echo "#beginTestCaseResult $c"
    # A 4th and 5th scenario column ("stage<TAB>file", the file beside the
    # scenario) gives the case a <Shader> with that GLSL in its <ShaderProgram>.
    stage=$(awk -F'\t' -v c="$c" '$1 == c { print $4; exit }' "${FAKE_SCENARIO:-/dev/null}")
    src=$(awk -F'\t' -v c="$c" '$1 == c { print $5; exit }' "${FAKE_SCENARIO:-/dev/null}")
    if [ "$(action "$c")" = info ] || [ -n "$stage" ]; then
      printf '<ShaderProgram LinkStatus="%s">\n' "$([ "$st" = Pass ] && echo true || echo false)"
      if [ -n "$stage" ]; then
        printf '<Shader Type="%s" CompileStatus="true">\n<ShaderSource>' "$stage"
        sed 's/&/\&amp;/g; s/</\&lt;/g' "$(dirname "$FAKE_SCENARIO")/$src"
        printf '</ShaderSource>\n'
      fi
      if [ "$(action "$c")" = info ]; then
        printf '<InfoLog>%s</InfoLog>\n' "$(infolog "$c" | sed 's/&/\&amp;/g; s/</\&lt;/g')"
      fi
      [ -n "$stage" ] && printf '</Shader>\n'
      printf '</ShaderProgram>\n'
    fi
    echo "<TestCaseResult Version=\"0.3.4\" CasePath=\"$c\" CaseType=\"SelfValidate\">"
    echo "<Result StatusCode=\"$st\">$st</Result>"
    echo "</TestCaseResult>"
    echo "#endTestCaseResult"
  } >> "$log"
done < "$list"
echo '#endSession' >> "$log"
echo "yakogl-mali-exit: status=0" >&2
exit 0
