+/* The blocks the command stream only points at.
+ *
+ * A texture descriptor, a shader binary or a vertex buffer never appears in
+ * the stream itself: the stream carries an address and the GPU fetches the
+ * block from memory. Diffing two streams therefore cannot see any of it, so a
+ * wrong 256-byte texture descriptor stays invisible while every register
+ * around it matches.
+ *
+ * Dump the memory as well, then. Every buffer the submit references is
+ * appended to the file named by ETNA_SHIM_MEM_DUMP as
+ *
+ *     u64 device address, u32 size, u32 zero, `size` bytes, padded to 8
+ *
+ * which is the format tools/vivante/cs_decode.py reads with --mem, and the
+ * one this backend's own OSAL writes for YAKOGL_MEM_DUMP, so one decoder
+ * resolves a pointer register on either side.
+ *
+ * The bytes come out of the shim's memfd at the buffer's own device address
+ * rather than out of a mapping, because the driver is free to have unmapped
+ * it by the time it submits.
+ */
+static void
+etnaviv_shim_dump_bos(int fd, struct drm_etnaviv_gem_submit *submit)
+{
+   static const uint8_t zeros[8] = { 0 };
+   const char *path = getenv("ETNA_SHIM_MEM_DUMP");
+   struct drm_etnaviv_gem_submit_bo *bos;
+   struct shim_fd *shim_fd;
+   FILE *f;
+   uint32_t i;
+
+   if (!path || !submit->bos || !submit->nr_bos)
+      return;
+
+   shim_fd = drm_shim_fd_lookup(fd);
+   if (!shim_fd)
+      return;
+
+   f = fopen(path, "ab");
+   if (!f)
+      return;
+
+   bos = (struct drm_etnaviv_gem_submit_bo *)(uintptr_t)submit->bos;
+   for (i = 0; i < submit->nr_bos; i++) {
+      struct shim_bo *bo = drm_shim_bo_lookup(shim_fd, bos[i].handle);
+      uint8_t *buf;
+
+      if (!bo)
+         continue;
+
+      buf = malloc(bo->size);
+      if (buf && pread(shim_device.mem_fd, buf, bo->size, bo->mem_addr) ==
+                    (ssize_t)bo->size) {
+         uint64_t addr = bo->mem_addr;
+         uint32_t size = bo->size, zero = 0;
+         size_t tail = (8u - (size % 8u)) % 8u;
+
+         fwrite(&addr, sizeof(addr), 1, f);
+         fwrite(&size, sizeof(size), 1, f);
+         fwrite(&zero, sizeof(zero), 1, f);
+         fwrite(buf, 1, size, f);
+         if (tail)
+            fwrite(zeros, 1, tail, f);
+      }
+      free(buf);
+      drm_shim_bo_put(bo);
+   }
+   fclose(f);
+}
+
+/* The golden command stream.
+ *
+ * A submit hands the kernel the exact words the GPU's front end would fetch,
+ * at `stream`, so this is the whole point of running the driver against the
+ * shim: no GPU is needed to see what a working driver tells this part to do.
+ * Each submit is appended to the file named by ETNA_SHIM_CS_DUMP as a length
+ * word followed by that many bytes; tools/vivante/cs_decode.py reads it.
+ */
+static int
+etnaviv_ioctl_gem_submit_dump(int fd, unsigned long request, void *arg)
+{
+   struct drm_etnaviv_gem_submit *submit = arg;
+   const char *path = getenv("ETNA_SHIM_CS_DUMP");
+
+   if (path && submit->stream && submit->stream_size) {
+      FILE *f = fopen(path, "ab");
+
+      if (f) {
+         uint32_t len = submit->stream_size;
+
+         fwrite(&len, sizeof(len), 1, f);
+         fwrite((const void *)(uintptr_t)submit->stream, 1, len, f);
+         fclose(f);
+      }
+   }
+
+   etnaviv_shim_dump_bos(fd, submit);
+
+   submit->fence = 1;
+   return 0;
+}
+
+/* The performance-monitor queries are walked until one fails. A no-op that
+ * succeeds for ever is walked for ever, so say there is nothing to report. */
+static int
+etnaviv_ioctl_enosys(int fd, unsigned long request, void *arg)
+{
+   /* errno matters: libdrm retries an ioctl that fails with EINTR or EAGAIN,
+    * so a -1 left with a stale errno is a spin, not a refusal. */
+   errno = EINVAL;
+   return -1;
+}
