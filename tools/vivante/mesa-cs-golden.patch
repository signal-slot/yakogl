+/* Resolving these costs a dlsym(RTLD_NEXT) scan of every loaded object, and
+ * every wrapper below calls this on entry. That is cheap for shader-db, which
+ * loads little; against a whole EGL/gallium stack the symbol tables are large
+ * enough that re-resolving them on each intercepted libc call never finishes.
+ * The results cannot change, so resolve them once. A thread that races in
+ * during the first fill simply writes the same pointers again. */
+static uint32_t have_function_pointers = 0;
+static uint32_t resolve_calls = 0;
+
 static void
 get_function_pointers(void)
 {
+   if (p_atomic_read(&have_function_pointers))
+      return;
+
    GET_FUNCTION_POINTER(access);
    GET_FUNCTION_POINTER(close);
    GET_FUNCTION_POINTER(closedir);
@@ -209,6 +221,11 @@
    GET_FUNCTION_POINTER(fstat);
    GET_FUNCTION_POINTER(fstat64);
 #endif
+
+   p_atomic_set(&have_function_pointers, 1);
+   if (getenv("DRM_SHIM_TRACE_SYMS"))
+      fprintf(stderr, "drm-shim: resolved libc symbols (call %u)\n",
+              p_atomic_inc_return(&resolve_calls));
 }
 
