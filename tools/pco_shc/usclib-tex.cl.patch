usclib tex.cl: textureSize() and textureQueryLevels() on a STRIDE image

Mesa 26.2.1 src/imagination/pco/usclib/tex.cl reads IMAGE_WORD1.baselevel
(bits 60..63) for every image. For a STRIDE (linear) image those bits are
STRIDE_IMAGE_WORD1.num_mip_levels, so the generic unpack added the level
count to the lod and every size came out halved that many times. YakoGL
samples linear textures, so textureSize() was wrong for all of them. The
patch skips baselevel for TEXTYPE_STRIDE in both functions.

Applies to the tarball tree with `patch -p1` from its root. Only the shaders
pco_shc compiles for the shader table use it; the driver's USC blobs
(gen_usc_blobs.py) do not sample and are the same with and without it.
Not offered upstream yet (Mesa's Vulkan driver never makes a STRIDE image
the shader queries this way).

--- a/src/imagination/pco/usclib/tex.cl
+++ b/src/imagination/pco/usclib/tex.cl
@@ -71,7 +71,11 @@
    ROGUE_TEXSTATE_IMAGE_WORD0_unpack(texstate_image_word0, &texstate_image_struct0);
    ROGUE_TEXSTATE_IMAGE_WORD1_unpack(texstate_image_word1, &texstate_image_struct1);
 
-   lod += texstate_image_struct1.baselevel;
+   /* A STRIDE (linear) image has no baselevel: bits 60..63 of its word 1
+    * are num_mip_levels (STRIDE_IMAGE_WORD1), which the generic unpack
+    * above would add to the lod (YakoGL samples every texture this way). */
+   if (texstate_image_struct0.textype != ROGUE_TEXSTATE_TEXTYPE_STRIDE)
+      lod += texstate_image_struct1.baselevel;
 
    uint3 size_comps = (uint3)(texstate_image_struct0.width + 1,
                               texstate_image_struct0.height + 1,
@@ -101,6 +105,14 @@
 
    ROGUE_TEXSTATE_IMAGE_WORD1_unpack(texstate_image_word1, &texstate_image_struct);
 
+   {
+      uint32_t texstate_image_word0[] = {tex_state.x, tex_state.y};
+      struct ROGUE_TEXSTATE_IMAGE_WORD0 texstate_image_struct0;
+
+      ROGUE_TEXSTATE_IMAGE_WORD0_unpack(texstate_image_word0, &texstate_image_struct0);
+      if (texstate_image_struct0.textype == ROGUE_TEXSTATE_TEXTYPE_STRIDE)
+         return 0;   /* STRIDE_IMAGE_WORD1: those bits are num_mip_levels */
+   }
    return texstate_image_struct.baselevel;
 }
 
