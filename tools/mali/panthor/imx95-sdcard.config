#
# The Verdin iMX95 microSD card's kernel: mainline v7.3 arm64 `defconfig`
# merged with this fragment (tools/mali/panthor/imx95-sdcard.sh). Every line
# is checked in the final .config after `olddefconfig`; a symbol the kernel
# drops or changes fails the build. Most of these are already in the
# defconfig of v7.3: they are named here so that the card does not lose one
# when a later defconfig changes.

# The GPU: panthor as a module (the route's driver), no kbase in mainline.
CONFIG_DRM=m
CONFIG_DRM_PANTHOR=m

# i.MX 95 System Manager over SCMI: clocks, power domains, pins, perf, the
# NXP vendor protocols (BBM, MISC, LMM, CPU).
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_POWER_DOMAIN=y
CONFIG_ARM_SCMI_PERF_DOMAIN=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_PINCTRL_IMX_SCMI=y
CONFIG_IMX_SCMI_BBM_EXT=y
CONFIG_IMX_SCMI_MISC_EXT=y
CONFIG_IMX_SCMI_MISC_DRV=y
CONFIG_IMX_MBOX=y
CONFIG_CLK_IMX95_BLK_CTL=y
CONFIG_IMX9_BLK_CTRL=y

# The SCMI raw interface beside the normal SCMI drivers, in debugfs:
# tools/imx95_bbm_record.sh reads the reset-surviving record through
# /sys/kernel/debug/scmi/<n>/raw/message.
CONFIG_DEBUG_FS=y
CONFIG_ARM_SCMI_RAW_MODE_SUPPORT=y
CONFIG_ARM_SCMI_RAW_MODE_SUPPORT_COEX=y

# The console: LPUART1 (Verdin UART_3, serial2 -> ttyLP2, 115200).
CONFIG_SERIAL_FSL_LPUART=y
CONFIG_SERIAL_FSL_LPUART_CONSOLE=y

# The root file system on the microSD card (usdhc2, mmc1): built in, there is
# no initramfs. Card detect and power are SoC GPIOs and GPIO regulators.
CONFIG_MMC_SDHCI_ESDHC_IMX=y
CONFIG_MMC_BLOCK=y
CONFIG_GPIO_VF610=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_GPIO=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y

# Ethernet for ssh: the on-module ENETC v4 port 0 (PCI 1131:e101), its EMDIO,
# the NETC block control, the TI DP83867 PHY whose interrupt goes through
# the PCAL6416 expander on LPI2C2.
CONFIG_NXP_ENETC4=m
CONFIG_FSL_ENETC_MDIO=m
CONFIG_NXP_NETC_BLK_CTRL=m
CONFIG_DP83867_PHY=y
CONFIG_GPIO_PCA953X=y
CONFIG_I2C_IMX_LPI2C=y

# kexec and the crash kernel, for the later crash-kexec route.
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
CONFIG_CRASH_DUMP=y
CONFIG_PROC_VMCORE=y

# The generic virt machine of the host's boot test (qemu).
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
