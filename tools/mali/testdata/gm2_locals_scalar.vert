/* LOCALS (original reduction): 40 scalar float locals from one attribute and
 * uniforms, a running sum through varying v. A scalar is one local, as a vec4
 * is, so the count is of declarations, not of lanes. */
attribute vec4 p;
uniform float k[40];
varying float v;
void main()
{
	float f0 = (p.x + k[0]) * (p.y + k[0]);
	float f1 = (p.y + k[1]) * (p.z + k[1]);
	float f2 = (p.z + k[2]) * (p.w + k[2]);
	float f3 = (p.w + k[3]) * (p.x + k[3]);
	float f4 = (p.x + k[4]) * (p.y + k[4]);
	float f5 = (p.y + k[5]) * (p.z + k[5]);
	float f6 = (p.z + k[6]) * (p.w + k[6]);
	float f7 = (p.w + k[7]) * (p.x + k[7]);
	float f8 = (p.x + k[8]) * (p.y + k[8]);
	float f9 = (p.y + k[9]) * (p.z + k[9]);
	float f10 = (p.z + k[10]) * (p.w + k[10]);
	float f11 = (p.w + k[11]) * (p.x + k[11]);
	float f12 = (p.x + k[12]) * (p.y + k[12]);
	float f13 = (p.y + k[13]) * (p.z + k[13]);
	float f14 = (p.z + k[14]) * (p.w + k[14]);
	float f15 = (p.w + k[15]) * (p.x + k[15]);
	float f16 = (p.x + k[16]) * (p.y + k[16]);
	float f17 = (p.y + k[17]) * (p.z + k[17]);
	float f18 = (p.z + k[18]) * (p.w + k[18]);
	float f19 = (p.w + k[19]) * (p.x + k[19]);
	float f20 = (p.x + k[20]) * (p.y + k[20]);
	float f21 = (p.y + k[21]) * (p.z + k[21]);
	float f22 = (p.z + k[22]) * (p.w + k[22]);
	float f23 = (p.w + k[23]) * (p.x + k[23]);
	float f24 = (p.x + k[24]) * (p.y + k[24]);
	float f25 = (p.y + k[25]) * (p.z + k[25]);
	float f26 = (p.z + k[26]) * (p.w + k[26]);
	float f27 = (p.w + k[27]) * (p.x + k[27]);
	float f28 = (p.x + k[28]) * (p.y + k[28]);
	float f29 = (p.y + k[29]) * (p.z + k[29]);
	float f30 = (p.z + k[30]) * (p.w + k[30]);
	float f31 = (p.w + k[31]) * (p.x + k[31]);
	float f32 = (p.x + k[32]) * (p.y + k[32]);
	float f33 = (p.y + k[33]) * (p.z + k[33]);
	float f34 = (p.z + k[34]) * (p.w + k[34]);
	float f35 = (p.w + k[35]) * (p.x + k[35]);
	float f36 = (p.x + k[36]) * (p.y + k[36]);
	float f37 = (p.y + k[37]) * (p.z + k[37]);
	float f38 = (p.z + k[38]) * (p.w + k[38]);
	float f39 = (p.w + k[39]) * (p.x + k[39]);
	float s = f0;
	s += f1;
	s += f2;
	s += f3;
	s += f4;
	s += f5;
	s += f6;
	s += f7;
	s += f8;
	s += f9;
	s += f10;
	s += f11;
	s += f12;
	s += f13;
	s += f14;
	s += f15;
	s += f16;
	s += f17;
	s += f18;
	s += f19;
	s += f20;
	s += f21;
	s += f22;
	s += f23;
	s += f24;
	s += f25;
	s += f26;
	s += f27;
	s += f28;
	s += f29;
	s += f30;
	s += f31;
	s += f32;
	s += f33;
	s += f34;
	s += f35;
	s += f36;
	s += f37;
	s += f38;
	s += f39;
	v = s;
	gl_Position = p;
}
