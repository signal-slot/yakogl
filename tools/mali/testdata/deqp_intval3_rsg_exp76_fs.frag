precision mediump float;
uniform mediump int c;
varying mediump float d;
varying mediump vec3 e;
const bool f = (bvec2(false, 1).t);
uniform mediump int h;
varying mediump float i;

void main()
{
	int g = int(i) * 1;
	g = g;
	gl_FragColor = vec4(h, g - int(f), f, false);
	float b = d * e.g;
	vec4 a = (exp2(vec4(d, b, c, b)));
	gl_FragColor = sqrt(a.garb);
	-5.5;
}
