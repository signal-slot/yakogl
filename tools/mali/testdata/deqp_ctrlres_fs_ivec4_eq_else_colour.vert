attribute vec4 dEQP_Position;
uniform mediump float z;
const int y = -14;
const int x = int(true) - int(-3);
attribute float w;
attribute float v;
attribute float q;
vec2 r = vec2(1.0, false).yx;
int s = (int(true));
uniform mediump int t;
attribute float u;
varying mediump float p;
varying mediump float a;
varying mediump float d;
varying mediump float l;
varying mediump float m;
varying mediump float o;

void main()
{
	gl_Position = dEQP_Position;
	p = z - w;
	a = v + float(u);
	d = float(y) + float(3);
	l = (p);
	m = (float(x));
	o = vec2(w, v).x;
	p = u;
	p = -3.25 * q;
	r = vec2(t, int(s));
	if (float(m) + 0.001 >= m)
		l = q;
}
