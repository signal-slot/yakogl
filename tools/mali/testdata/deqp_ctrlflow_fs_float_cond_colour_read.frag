precision mediump float;
varying mediump vec4 h;
const bool d = (abs(float(-4) - (float(-4))) < 0.001) == true;
const bool c = int(3.0) >= int(-0.75);
varying mediump vec4 b;
varying mediump float e;
const bool f = false;
varying mediump vec4 g;

void main()
{
	gl_FragColor = h.abgr;
	gl_FragColor = gl_FragColor;
	if (e <= e + 0.001)
		gl_FragColor = gl_FragColor * g;
	else 
		gl_FragColor = vec4(f, bool(true), e, int(c));
	{
		gl_FragColor = vec4(d, 1, 1, c).ywzx;
		vec4 a = (vec4(-5.5, 4.5, -5.5, -2));
		a = a + b;
	}
}
