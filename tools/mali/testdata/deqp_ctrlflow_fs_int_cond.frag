precision mediump float;
const bool n = float(5.5) + 0.001 >= 3.5;
varying mediump float m;
const int l = (-1);
int g = ivec4(l, n, n, 4.0).z;
const int f = int(-7) * int(n);
const int e = 2 * 1;
const int d = 4;
const float c = 2.5;
const float b = float(float(-1.5));
varying mediump float a;
bvec4 h = bvec4(int(0.25), 0, float(1), n);
varying mediump float i;
uniform mediump int j;
uniform mediump int k;

void main()
{
	gl_FragColor = vec4(n, false, -8, -12.25) * vec4(l, m, l, i);
	if (k < j)
		h = bvec4(i, bool(1), 0.0, 1);
	else 
		gl_FragColor = (gl_FragColor);
	{
		gl_FragColor = vec4(b, g, d, f).pqst;
		gl_FragColor = vec4(f, b, e, d) + vec4(7.5, c, b, a);
	}
}
