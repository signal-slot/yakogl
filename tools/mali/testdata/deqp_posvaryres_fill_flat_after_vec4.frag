precision mediump float;
varying mediump float a;
varying mediump float b;
uniform mediump float c;
uniform mediump vec4 e;
varying mediump float f;
varying mediump float g;
varying mediump vec4 h;
const vec4 i = vec4(1.0 + float(3.5), float(-11.0) + 5.0, -1.75, float(float(3.25)));
const float j = 2.5 * (-1.0);
const float k = 4.0;
varying mediump float l;
uniform mediump float m;
varying mediump float p;

void main()
{
	float n = 18.0 + float(-7.5) + m;
	float o = n;
	gl_FragColor = vec4(p, float(p), float(f), float(g)) + vec4(o, n, m, 2.5) * vec4(l, g, -0.5, a);
	vec4 d = (vec4(-6.0, k, 2.0, j) + i);
	gl_FragColor = h - (vec4(f, g, f, c));
	gl_FragColor = e * d * (vec4(c, -1.0, b, a));
}
