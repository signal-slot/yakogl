#version 100
precision mediump float;
uniform vec4 u_w[4];
uniform sampler2D u_s0;
uniform sampler2D u_s1;
uniform sampler2D u_s2;
uniform sampler2D u_s3;
uniform sampler2D u_s4;
uniform sampler2D u_s5;
uniform sampler2D u_s6;
uniform sampler2D u_s7;
uniform sampler2D u_s8;
uniform sampler2D u_s9;
uniform sampler2D u_s10;
uniform sampler2D u_s11;
uniform sampler2D u_s12;
uniform sampler2D u_s13;
uniform sampler2D u_s14;
uniform sampler2D u_s15;
void main() {
    vec2 c = vec2(0.5);
    vec4 r = vec4(0.0);
    r += u_w[0].x * texture2D(u_s0, c);
    r += u_w[0].y * texture2D(u_s1, c);
    r += u_w[0].z * texture2D(u_s2, c);
    r += u_w[0].w * texture2D(u_s3, c);
    r += u_w[1].x * texture2D(u_s4, c);
    r += u_w[1].y * texture2D(u_s5, c);
    r += u_w[1].z * texture2D(u_s6, c);
    r += u_w[1].w * texture2D(u_s7, c);
    r += u_w[2].x * texture2D(u_s8, c);
    r += u_w[2].y * texture2D(u_s9, c);
    r += u_w[2].z * texture2D(u_s10, c);
    r += u_w[2].w * texture2D(u_s11, c);
    r += u_w[3].x * texture2D(u_s12, c);
    r += u_w[3].y * texture2D(u_s13, c);
    r += u_w[3].z * texture2D(u_s14, c);
    r += u_w[3].w * texture2D(u_s15, c);
    gl_FragColor = r;
}
