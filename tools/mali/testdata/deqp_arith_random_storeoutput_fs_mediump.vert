attribute vec4 dEQP_Position;
attribute float v;
const float u = (5.5) + float(-4.5);
attribute float t;
const float s = -4.5;
const float r = -8.0;
uniform mediump float q;
varying mediump float d;
varying mediump float e;
varying mediump float l;
varying mediump float m;
varying mediump float n;

void main()
{
	gl_Position = dEQP_Position;
	d = 10.75 + (-1.25);
	e = v;
	l = 0.5 - u;
	m = t + float(3.0) - s;
	n = float(r) * 0.25;
	m = m - q;
	m;
}
