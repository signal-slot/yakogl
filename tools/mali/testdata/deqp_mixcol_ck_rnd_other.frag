precision mediump float;
const float e = -6.5 - float(7.0) * -1.0;
varying mediump float d;
float c = float(float(-7.625)) + float(float(7.5));
varying mediump float a;
varying mediump float b;

void main()
{
	gl_FragColor = vec4(float(e) * 2.0, (float(d)), c * 2.0, float(c));
	gl_FragColor = (gl_FragColor) * (vec4(0.5, -0.0, b, a));
	gl_FragColor = gl_FragColor;
}
