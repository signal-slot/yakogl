varying mediump vec4 c;
float d = (float(-1.25)) * vec4(b, false, -0.5, 3).b;
const int h = int(-13.0) + int(int(7));
varying mediump float g;
float f = float(-11.5) + float(4.75) + vec4(2.5, h, false, b).s;
uniform mediump int e;
int i = (ivec2(true, true)).t;

void main()
{
	if (vec3(b, h, i).p > f * -1.25)
	{
		gl_FragColor = vec4(float(int(h)), float(h) * float(1.25), g + f, int(e) * 1);
