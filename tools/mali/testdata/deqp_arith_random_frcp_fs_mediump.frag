precision mediump float;
uniform sampler2D a;
varying mediump float b;
const bool c = (bvec3(0, 1.0, 1).y);
varying mediump float d;
const int f = -12;
const bool h = c;
varying mediump float i;
uniform mediump int j;
const float k = (float(3) + float(5.5));
uniform mediump float l;
uniform sampler2D m;
const int n = int(vec2(16, k).s);
varying mediump float o;
varying mediump float p;
const bool q = bvec4(1, 1.0, h, 0.0).yzwx.t;
uniform mediump float r;
const int s = ivec2(h, -9).y + (-5);
varying mediump vec4 t;
varying mediump vec4 u;

void main()
{
	gl_FragColor = u.brag - t.abgr;
	gl_FragColor = vec4(-2, s, r, f) + vec4(d, q, k, 2.0) + (vec4(o, n, -2, p));
	gl_FragColor = texture2DProj(m, vec3(o, n, i), float(false)).spqt;
	gl_FragColor = (vec4(l, false, h, k) * vec4(b, j, i, -1.75));
	int e = -1;
	float g = i;
	gl_FragColor = vec4(h, float(f), g, (int(true)));
	gl_FragColor = texture2DProj(a, vec3(f, c, e) * vec3(b, false, d), float(c) + b);
}
