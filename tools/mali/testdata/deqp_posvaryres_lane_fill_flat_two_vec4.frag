varying mediump vec3 d;
varying mediump float e;
const bool f = bool(1.0);
const float g = float(2) * -1.0;
uniform mediump int h;
const ivec2 i = ivec2(int(f), float(1.0));
varying mediump float j;
varying mediump vec4 k;

void main()
{
	gl_FragColor = (vec4(-1.5, m, l, l));
