attribute vec4 dEQP_Position;
uniform mediump float n;
uniform mediump int m;
const float l = float(-6.5) + -6.0;
attribute float k;
const int j = int(0) + 0;
varying mediump vec4 b;
varying mediump vec4 f;

void main()
{
	gl_Position = dEQP_Position;
	b = vec4(-0.5, n, int(m), 9);
	f = vec4(-4, l, -8.0, -8.0) - vec4(k, -5.5, -1, j);
}
