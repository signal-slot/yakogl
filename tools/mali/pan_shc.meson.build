# SPDX-License-Identifier: MIT
#
# pan_shc in Mesa's tree: build_pan_shc.sh copies this file to
# src/panfrost/pan_shc/meson.build, next to pan_shc.c, the shim headers of
# tools/mali/pan_shc-shim/ and unmodified copies of three gallium panfrost
# passes. tools/mali/mesa-pan_shc.patch adds the subdir.

pan_shc = executable(
  'pan_shc',
  [
    'pan_shc.c',
    'pan_nir_lower_sysvals.c',
    'pan_nir_lower_res_indices.c',
    'pan_nir_remove_fragcolor_stores.c',
  ],
  include_directories : [
    include_directories('.'),
    inc_include, inc_src, inc_gallium, inc_panfrost, inc_valhall,
  ],
  c_args : [no_override_init_args, compile_args_panfrost],
  dependencies : [
    idep_nir, idep_vtn, idep_mesautil, idep_bi_opcodes_h, idep_valhall_enums_h,
    idep_pan_packers, libpanfrost_dep, libpanfrost_model_dep, dep_libdrm,
  ],
  link_with : [libpanfrost_compiler],
  build_by_default : false,
)
