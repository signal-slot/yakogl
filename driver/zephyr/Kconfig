config SAFEUI_SN65DSI8X
	bool "TI SN65DSI83/84 DSI-to-LVDS bridge (yakogl,sn65dsi8x), register logic in Rust"
	default y
	depends on DT_HAS_YAKOGL_SN65DSI8X_ENABLED
	select SAFEUI_DISPLAY_RUST
	select I2C
	select GPIO
	help
	  The bridge as a device on its I2C bus:
	  driver/drivers/display/bridge_sn65dsi8x.c registers it,
	  driver/rust/src/ip/sn65dsi8x.rs programs it (from TI SLLSEC2H /
	  SLLSEC1I). A node with a dsi-host starts itself (the AM62P); one
	  without is driven by its display controller (the i.MX8MP's
	  safeui,imx8mp-display).

if SAFEUI_SN65DSI8X

config SAFEUI_SN65DSI8X_INIT_PRIORITY
	int "Init priority of a bridge driven by its display controller"
	default 75
	help
	  After I2C and GPIO, before the controller (safeui,imx8mp-display,
	  80) that claims its EN pin at init. Nothing is touched here.

config SAFEUI_SN65DSI8X_SELF_START_INIT_PRIORITY
	int "Init priority of a bridge that starts itself (dsi-host)"
	default 90
	help
	  After its DSI host and the video source (the AM62P DSI 70, DSS 80):
	  the whole bring-up runs here.

module = SAFEUI_SN65DSI8X
module-str = sn65dsi8x
source "subsys/logging/Kconfig.template.log_config"

endif # SAFEUI_SN65DSI8X

rsource "lib/board/Kconfig"

rsource "Kconfig.am62p"
