# The STM32MP257F-DK's Cortex-A35 board layer, its core (stm32mp2.c): outside
# the board layer YAKOGL_BOARD, as YAKOGL_NANOPC_T6 is.

config YAKOGL_STM32MP2
	bool "STM32MP257F-DK A35: early banner, hand-over record, PSCI reset at the end"
	default y
	depends on SOC_SERIES_STM32MP2X_A35
	help
	  The early banner (raw MP2:A/A1 lines on USART2 before the
	  console), the hand-over record line (what the previous stage left:
	  EL, SCTLR M/C/I, x0-x3 with the DTB pointer, the entry address,
	  CNTFRQ_EL0, MPIDR_EL1, PSCI_VERSION), and
	  mp2_reset_to_linux() (stm32mp2.h), the end of a run: PSCI
	  SYSTEM_RESET. A fatal error and the end of the lifetime take the
	  same way out.

config YAKOGL_STM32MP2_LIFETIME_S
	int "Seconds of uptime after which the layer resets the board through PSCI"
	default 20
	range 5 3600
	depends on YAKOGL_STM32MP2
	help
	  The run must end before it (mp2_reset_to_linux()). A timer of the
	  system clock: it does not cover a hang with interrupts locked, or
	  one before the kernel runs; the OP-TEE watchdog does, once the layer
	  arms it.

config YAKOGL_STM32MP2_WDOG
	bool "STM32MP257F-DK A35: arm OP-TEE's watchdog (arm,smc-wdt) at boot and feed it"
	default n
	depends on YAKOGL_STM32MP2
	help
	  stm32mp2_wdog.c: SET_TIMEOUT 32, ENABLE 1, PET at PRE_KERNEL_1 0
	  over SMC (function id 0xbc000000, ST's arm,smc-id), the line
	  "gc_wdog_arm: armed" (the literal tools/board.sh requires) at 99,
	  or on a refusal what refused and PSCI SYSTEM_RESET at once, and a
	  1 s PET until the lifetime. Off by default; an image asks for it
	  (tools/probes/stm32mp257f_dk/mp2_identify).

config YAKOGL_STM32MP2_GPU
	bool "STM32MP257F-DK A35: the GPU power C ABI (stm32mp2_gpu.h) in libyakogl_drivers.a"
	default y if YAKOGL_DRV_GPU_VIVANTE
	depends on YAKOGL_STM32MP2
	select YAKOGL_DRV_DISPLAY_RUST
	help
	  The yakogl-drivers crate is built with the features stm32mp2 and
	  vivante (driver/zephyr/CMakeLists.txt) and linked: one archive for
	  the image, whether the Vivante driver is in it (gc_fence, gc_clear:
	  on by default with it) or not (the mp2_gpu probe asks for it). With
	  the driver, gc_power_mp2.c powers the GPU for it (gc_board_power_on:
	  SCMI over OP-TEE, every message on the console, the RCC gate and
	  reset), and refuses a part that is not model 0x8000 revision 0x6205
	  (#1281) with a PSCI reset.

config YAKOGL_BOARD_STM32MP2
	def_bool YAKOGL_BOARD && YAKOGL_STM32MP2
	help
	  The board layer (yakogl_board.h) on the DK's A35
	  (board_stm32mp2.c): no window or screen yet; record: the
	  yk-record line on USART2; reset: mp2_reset_to_linux() (PSCI
	  SYSTEM_RESET), the watchdog OP-TEE's (YAKOGL_STM32MP2_WDOG).
