mainmenu "gl_test"

# One sample for every board: the Zephyr board (-b) picks the GPU and its
# board side. The options below are grouped by the GPU whose main_*.c reads
# them; the first two are shared.

menu "gl_test, every GPU"

config GL_TEST_RUNNER
	bool
	default y
	select YAKOGL_GL_TEST_RUNNER
	help
	  The suite's walker is the gl_test runner (driver/tools/pvrlab/runner,
	  Rust): which cases run, each one's skip and PASS/FAIL/TIMEOUT line,
	  the tally the board's record reads and the "gl_test: all:" line. The
	  case bodies are the C ones of tools/pvrlab/gl_test.c, whose
	  gl_test_run calls the runner, so the image takes the library with it
	  (CONFIG_YAKOGL_GL_TEST_RUNNER). The console text is unchanged, so
	  tools/board.sh parses it as before.

config GL_TEST_KNOBS
	bool
	default y if YAKOGL_GPU_POWERVR || YAKOGL_GPU_VIVANTE
	select YAKOGL_TEST_KNOBS
	help
	  The suite sets the library's test knobs (CONFIG_YAKOGL_TEST_KNOBS).
	  On the GC7000: case 16's 4x scratch probes, case 132's two narrow-L8
	  arms, case 88's flip study. On the PowerVR: the bring-up options
	  (gl_test_run's pretransform and debug arguments, case 62's clip
	  sweep, the primitive budget of the split cases), and the arms of
	  case 123 (pvr_debug_set_split_zs) and case 132
	  (pvr_debug_set_narrow_la). gl_test.c calls them only under
	  CONFIG_YAKOGL_TEST_KNOBS; a product image has none of them. Not on
	  the Pi 4.

config GL_TEST_VSU_UNITS
	int "Case 149 (vsunits): vertex-stage samplers the shader declares"
	range 1 16
	default 16
	help
	  Case 149 declares and draws with this many vertex samplers
	  (u_s0..u_s<N-1>); cells N..15 are not drawn and must stay blue.
	  Used to find the smallest count that faults the GPU (RESULTS 1t).

config GL_TEST_VSU_FS_UNITS
	int "Case 149 (vsunits): fragment-stage samplers beside the vertex ones"
	range 0 16
	default 0
	help
	  The fragment shader also declares and samples this many samplers
	  (u_f0.., magenta 1x1 textures on units 16..) with a zero weight, so
	  the picture is unchanged. On the GC7000 the vertex slots start after
	  the fragment ones: 16 puts vertex sampler k in slot 16 + k. 0 is the
	  case as it was.

endmenu

menu "gl_test on the Verdin AM62P (PowerVR BXS-4-64)"
	depends on YAKOGL_GPU_POWERVR

config GL_TEST_CASE
	int "gl_test case to run (7 = every case, 0..6 and 8..20 single cases)"
	default 7

config GL_TEST_CASES
	string "Cases to run in order on one context, comma-separated (overrides GL_TEST_CASE)"
	default ""
	help
	  When set, the listed case numbers of driver/tools/pvrlab/gl_test.c
	  are walked through gl_test_set_list on one context, as the
	  i.MX8MP's and the Pi 4's samples do, so one image runs a chosen set
	  (for example "169,162,167,168,123"). Empty: GL_TEST_CASE alone.

config GL_TEST_FWCCB_LOSS_SECONDS
	int "Case 174 (fwccbloss): seconds of frames"
	default 25
	help
	  Case 174 reproduces the lost FWCCB command (the AM62P glmark2
	  cell): frames of full-screen quads into a 1024x1024 target, more
	  each phase, so the firmware keeps asking for grows, for this many
	  seconds. Build it with YAKOGL_DRV_GPU_PVR_FL_GROW_ON_DEMAND (every
	  grow served) and YAKOGL_DRV_GPU_PVR_FWCCB_CHECK, and
	  GL_TEST_CASES="174".

config GL_TEST_FORCEDPR_LAYERS
	int "Case 217 (forcedpr): 512x512 rectangles in the one frame"
	default 256
	range 1 4093
	help
	  Case 217 draws this many overlapping rectangles of known colour
	  and depth into a 1024x1024 target in one kick, to exceed a free
	  list capped at 512 pages (YAKOGL_DRV_GPU_PVR_FL_PROBE_MAX_PAGES),
	  and reads the whole target back. Raise it when the case prints
	  "NOT EXERCISED" (the frame fitted the list). Not in the default
	  list: without YAKOGL_DRV_GPU_PVR_PARTIAL_RENDER it hangs by design
	  (driver/tools/pvrlab/README.md, "Case 217").

config GL_TEST_FWCCB_LOSS_MAX_LAYERS
	int "Case 174 (fwccbloss): layers a frame at most"
	default 1024
	help
	  The ramp's cap. 30 on the AM62P (v8): v7's held runs survived 47-53
	  phases at 30 layers, and 33 hangs a frame alone (cause 4); a run
	  whose request count missed v7's hold rose to 33 and hung. With 30
	  every run holds at the same load.

config GL_TEST_FWCCB_LOSS_HOLD_GROWS
	int "Case 174 (fwccbloss): served grows after which the load stops rising"
	default 10
	help
	  10 keeps the list below its maximum (v3). The load also stops
	  rising at the first refused grow: with
	  YAKOGL_DRV_GPU_PVR_FL_PROBE_SERVE_MAX=3, three grows are served, the
	  fourth request is refused, and from then on each overlap asks and
	  is refused: glmark2's sequence before its lost command (v5).

config GL_TEST_PANEL
	int "Draw on the panel instead: 1 = demo scene, 2 = spinning MSAA cube (0 = run the case)"
	default 0
	range 0 2

config GL_TEST_DEBUG
	int "Backend debug: 1 = command-stream dumps, 2 = depth/stencil dumps"
	default 0
	range 0 2
	help
	  PVR_BACKEND_OPT_DEBUG / _DS_DUMP, test knobs: they take effect
	  because this image selects CONFIG_YAKOGL_TEST_KNOBS (GL_TEST_KNOBS).

config GL_TEST_PRETRANSFORM
	bool "Case 0 feeds screen-space vertices (TA viewport transform off)"
	help
	  PVR_BACKEND_OPT_PRETRANSFORM, a test knob (see GL_TEST_DEBUG).

config GL_TEST_PVR_FS_TEMPS_MIN
	int "PowerVR: declare at least this many fragment temporaries (PVR_BACKEND_OPT_FS_TEMPS_MIN, a measurement)"
	depends on YAKOGL_GPU_POWERVR
	range 0 252
	default 0
	help
	  Passed to pvr_backend_set_option(PVR_BACKEND_OPT_FS_TEMPS_MIN) at
	  startup: every fragment kick allocates max(the shader's temps, this)
	  temporaries per instance, the program unchanged. 0 is the shader's
	  own count. For the A/B of case 39 perf between the online compiler
	  and the offline table: never a default. A product option until the
	  shader-compiler rename.

endmenu

menu "gl_test on the i.MX8M Plus (Vivante GC7000UL)"
	depends on YAKOGL_GPU_VIVANTE

config GC_GL_TEST_CASE
	int "Which gl_test case to run (7 = the regression set)"
	default 7
	help
	  The case numbers are tools/pvrlab/gl_test.c's own; its header
	  comment lists them. 7 runs the regression set, whose order[] is in
	  gl_test_run().

config GC_GL_TEST_SWEEP
	bool "Sweep 48 case numbers in one run, each result in the SNVS record"
	help
	  Runs cases GC_GL_TEST_SWEEP_FIRST .. +47 (7, the regression set,
	  counts as skipped) through gl_test's list walker on one context,
	  and after every case rewrites a SWEEP record (gc_result.h) with two
	  bits per case. Cases named in GC_GL_TEST_SKIP report as skipped.
	  GC_GL_TEST_CASE is ignored.

config GC_GL_TEST_SWEEP_FIRST
	int "First case number of the sweep"
	default 0
	depends on GC_GL_TEST_SWEEP

config GC_GL_TEST_SWEEP_LISTS
	string "Case lists a run-time selector can pick (';'-separated)"
	default ""
	depends on GC_GL_TEST_SWEEP
	help
	  Selector 0x200 + k (gc_result.h) runs the k-th list of this table
	  instead of the sweep's range, in the order written, on one context,
	  and ends with the sweep's counters record. A list is comma-separated
	  case numbers and ranges, all inside the sweep's 48: "10-18,19". For
	  finding the earliest case whose presence makes a later one fail.

config GC_GL_TEST_SETTLE_SECONDS
	int "Seconds from boot before the verdict is given"
	default 0
	help
	  0: the verdict is the result record, and the image resets the SoC
	  right after writing it (gc_sample_finish_recorded), so a one-case
	  run costs its boot and its case.

	  Only for the diagnostic knobs that still answer in the return time
	  (REPORT_COUNTERS, REPORT_CHECK, DEPTH_VALUE, DEPTH_PROBE; README
	  "Reading a run"): set it longer than the suite takes, 100 as in the
	  README's readings, so the suite's own duration is not a second
	  unknown in the total. It logs its duration.

config GC_GL_TEST_DEADLINE_SECONDS
	int "Seconds before the supervisor gives up on the suite"
	default 200
	help
	  The watchdog Linux left armed fires at about 128 s and the suite
	  takes longer than that, so a thread of its own feeds it. Past this
	  deadline that thread stops waiting, writes the case it was in as an
	  UNFINISHED record and resets the SoC, so a hung suite is a reading
	  rather than two silent minutes.

config GC_GL_TEST_REPORT_CHECK
	bool "A single case reports the check inside it that failed first"
	help
	  A case is one bit on a board with no console: PASS or FAIL. That is
	  enough to see a fix land and not enough to find one, because a case
	  makes twenty-odd checks and they fail for different reasons. With
	  this the hold carries the first failing check instead: 1 when the
	  case passed, 1 + the check's number when one failed, 63 when it
	  failed without any check saying so (a GL error, or a check past 61).
	  Off by default, so the plain PASS/FAIL holds keep their meaning.

config GC_GL_TEST_REPORT_CHECK_COLOUR
	bool "...and reports the colour it read rather than its number"
	depends on GC_GL_TEST_REPORT_CHECK
	help
	  Once the failing check is known its number is not news any more, but
	  what it read still is: a mip level that comes back green where blue
	  was wanted says the LOD stopped one level short, while black says
	  nothing was drawn at all. The hold then carries the colour as 32 plus
	  one bit per channel at half scale, so 32 is black, 33 blue, 34 green,
	  36 red and 39 white.

config GC_GL_TEST_REPORT_COUNTERS
	bool "Report what the run waited on, rather than how far it got"
	help
	  Every case of the suite finishes in seconds on its own, and the
	  regression set does not finish inside its deadline, so something
	  accumulates across the cases. There are exactly two waits in the path
	  long enough to account for it: the 2 s a fence wait gives up after,
	  and the 1 s a submit waits for one of the thirty hardware events to
	  come free. This puts both in the hold instead of the case number: bit
	  5 is set when a submit ever found every event in flight, and the low
	  five bits are the number of fence timeouts, saturating at 31. So a
	  hold code of 0 says the time went somewhere else entirely.

config GC_GL_TEST_COUNTER_SELECT
	int "Which number GC_GL_TEST_REPORT_COUNTERS puts in the hold"
	depends on GC_GL_TEST_REPORT_COUNTERS
	default 0
	help
	  0 packs both flags: bit 5 when a submit ever found all thirty events
	  in flight, the low five bits the fence timeouts, saturating at 31.
	  1 reports instead the seconds spent inside the two waits, saturating
	  at 63, which is the question the flags only stand in for --
	  gc_event_alloc loops rather than giving up, so a submit can wait a
	  long time for an event without the starvation flag ever being set.
	  3 reports the case the suite was in when a kick first failed to
	  complete, or 63 when none did. A kick that never completes costs two
	  seconds and leaks its hardware event for good, so thirty of them slow
	  every submit that follows: without this, a hang reads from outside as
	  the suite merely being slow, which is how it read for a while.
	  2 reports the same time in units of eight seconds, so the scale
	  reaches the whole deadline a regression set is given: a set saturates
	  select 1 a sixteenth of the way in, and "63 or more" does not say
	  whether the waits are a sixth of the run or all of it.

config GC_GL_TEST_ZPROBE_MILLI
	int "The depth case 53 clears to, in thousandths"
	default 500
	range 0 1000
	help
	  Case 53 clears depth to this value and does nothing else, so that
	  GC_GL_TEST_DEPTH_VALUE can read back what the hardware stored. 500
	  is the 0.5 that gl_test case 13's first check asks for.

	  Set it to 250 to tell a code of 63 meaning "the clear value was
	  ignored" from a code of 63 meaning "the surface is not uniform": a
	  quarter reads back as 15 or 16, and only the first reading moves.

config GC_GL_TEST_DEPTH_VALUE
	bool "Report the value a depth clear actually stored"
	depends on YAKOGL_VIVANTE_DEPTH_GUARD
	help
	  Reads the word the depth surface mostly holds after the case and
	  holds its top six bits, so a run of case 53 -- which clears depth to
	  0.5 and does nothing else -- says what the hardware stored.

	  The code is the stored D24S8 word shifted right by 26. A value near
	  the top of a code's range rounds either way, so each expected value
	  spans two codes: 0.5 reads back as 31 **or** 32, 0.25 as 15 or 16,
	  1.0 as 63 and 0.0 as 0. Reading 31 as a failure because 32 was
	  written down would be the obvious mistake here.

	  62 means the surface holds no single value: the clear did not cover
	  it, and no stored depth can be reported. (62 is also depth
	  0.969..0.984, which nothing in the suite clears to.)

	  So 31 or 32 means the clear landed; 0 means it landed at the near end
	  of the range instead; 63 means the clear value was ignored and the
	  buffer still holds 1.0. 63 also stands for "the surface is not
	  uniform", which is a different finding; to tell the two apart, build
	  again with GC_GL_TEST_ZPROBE_MILLI=250 and see whether the code
	  becomes 15 or 16.

	  41 is the depth guard's own canary, 0xa5a5a5a5, which means the GPU
	  wrote none of the surface -- a different fault again, and one the
	  guard build makes readable for free.

config GC_GL_TEST_DEPTH_PROBE
	bool "Report whether the depth write stayed inside its surface"
	depends on YAKOGL_VIVANTE_DEPTH_GUARD
	help
	  Reads back the canary the guard build lays down around the depth
	  surface and puts the answer in the hold: 0 when nothing was written
	  at all, 1 when the write stayed inside, 2..62 when it ran outside by
	  (code - 1) * 4 KiB, 63 when there was no depth buffer. Turns "may a
	  depth surface be linear on this part" into a reading.

config GC_GL_TEST_SKIP
	string "Cases the regression set leaves out (decimal, comma separated)"
	default ""
	help
	  A case that hangs a kick costs every later case the two seconds each
	  hung kick waits, so one unfixed case can stop the set finishing at
	  all and hide the state of the thirty after it. Listing it here keeps
	  the rest readable while it is worked on. A skipped case counts as
	  neither a pass nor a failure, so the pass count stays honest.

config GC_GL_TEST_MSAA
	bool "Turn the GC7000's 4x MSAA on (a measurement, off in products)"
	depends on YAKOGL_TEST_KNOBS
	default n
	help
	  Calls gc_debug_set_msaa(1) at startup: the backend's 4x resolve
	  (vivante/backend.rs gc_debug_msaa, a test knob) and with it the EGL
	  4x config, which the GC7000 build otherwise does not offer. Case 16
	  then runs against a real 4x surface. Off by default until the board
	  has measured it (tools/cts/RESULTS.md, "GC7000 4x MSAA via the
	  resolve engine").

config GC_GL_TEST_MSAA_BITS
	int "gc_debug_msaa value case 16 runs with (1 = the 4x resolve)"
	depends on GC_GL_TEST_MSAA
	range 1 31
	default 1
	help
	  The argument of gc_debug_set_msaa. Bit 0 is the 4x path, bit 1
	  etnaviv's SMALL_MSAA settings (PS input and temporary + 1, PE_LOGIC_OP
	  UNK24 = 5), bit 2 a per-draw PS_MSAA_CONFIG, bit 3 the viewport and
	  clip scaled to the 2x scratch surface, bit 4 etnaviv's PE_LOGIC_OP
	  SINGLE_BUFFER value for the supertiled scratch. 19 = bits 0, 1 and 4
	  is what Mesa writes for a 4x target on this core; bits 2 and 3 are not
	  Mesa's (docs/notes/gc-msaa-addresses.md).

config GC_GL_TEST_UNIIDX_NO_CLAMP
	bool "gl_test 108: no clamp before the movar (a measurement)"
	depends on YAKOGL_SHADERC_ONLINE
	default n
	help
	  shc_debug_set_uniidx bit 0: a run-time-indexed uniform read uses its
	  index unclamped in the offset multiply, as Mesa's etnaviv does
	  (select.rs shc_debug_uniidx). Never a default: the clamp is an ir.md
	  rule.

config GC_GL_TEST_WIDTH
	int "Render target width in pixels"
	default 1280

config GC_GL_TEST_HEIGHT
	int "Render target height in pixels"
	default 800
endmenu

menu "gl_test on the Raspberry Pi 4 (V3D 4.2)"
	depends on YAKOGL_GPU_V3D

config V3D_GL_TEST_CASES
	string "The gl_test cases to run, in order, on one context"
	default "5,58,59,66,67,102,3,9,11,12,13,4,178"
	help
	  Comma-separated case numbers of driver/tools/pvrlab/gl_test.c,
	  walked through gl_test_set_list as the i.MX8MP's lists are. The
	  default is M6 step B's evidence (the clears the TLB cannot do) and
	  step C's (3 depth, 9 stencil, 11 persist, 12 stencil2, 13 zls:
	  depth and stencil kept across jobs), and 4 cull (glCullFace and
	  glFrontFace, which no V3D list ran until the winding was found
	  inverted by 12), and 178 heldfree (a depth texture right after a
	  scene's buffers were deleted; it runs on the V3D now);
	  docs/online-shaderc/v3d-backend.md.
	  Ignored when V3D_GL_TEST_CASE is set.

config V3D_GL_TEST_CASE
	int "Run this one case alone instead of the list (-1: the list)"
	default -1
	help
	  One case, on a fresh context, so its lines are the only ones on the
	  screen. 7 is gl_test's own regression set.

config V3D_GL_TEST_MSAA
	bool "Offer the 4x EGL config (a measurement, off in products)"
	default n
	help
	  Calls v3d_debug_set_msaa(1) at startup: the EGL 4x config, which
	  the V3D build otherwise does not offer (src/v3d/backend.rs
	  v3d_debug_msaa). Case 16 then runs against a real 4x surface, and
	  case 145 (sample coverage) has one to draw on. Off by default until
	  the board has measured it (docs/online-shaderc/v3d-backend.md,
	  "Multisampling").

config V3D_GL_TEST_VTL_PASSES
	int "Case 129 (vstexlod): run only its first N passes (0: all)"
	default 0
	range 0 11
	help
	  The case's passes go lightest first; a faulting pass prints the
	  OSAL's fault dump (records, uniform streams, vertex arrays, code),
	  and on the screen record every pass after it scrolls the dump away
	  (the UART keeps all of it). 1 runs the constant look-up alone, 2
	  adds the one-level control.

config V3D_GL_TEST_RECORD
	bool "One frozen record at the end of the run"
	default y
	help
	  The console scrolls and the board's watchdog ends the image, so the
	  first failure of a run can scroll off. With this, every printk line
	  is also kept in a ring, and at the end of the run (or at
	  V3D_GL_TEST_RECORD_AT_S after boot if the run has not ended) the
	  screen is cleared and one record is printed and frozen: the last
	  lines of the run, the OSAL's job record (the registers after the
	  first completed and the first failed job, the timeouts, UIFCFG), and
	  the verdicts.

config V3D_GL_TEST_RECORD_AT_S
	int "The record's deadline, seconds after boot"
	default 75
	depends on V3D_GL_TEST_RECORD

config V3D_GL_TEST_RECORD_LINES
	int "Lines of the run the record replays"
	default 22
	range 0 30
	depends on V3D_GL_TEST_RECORD
	help
	  The 1280x720 console has 44 rows; the job record takes about 10 and
	  the verdicts one per case, so a long case list wants fewer.

config V3D_GL_TEST_HOLD_S
	int "The watchdog's hold, seconds after boot"
	default 200
	range 30 300
	help
	  rpi_wdog resets the board this long after boot (bounded, as every
	  board image is): the run plus the time the record stays readable.
endmenu

rsource "../common/Kconfig"
