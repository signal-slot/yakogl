# SPDX-License-Identifier: Apache-2.0
# The AM62P second-stage loader (docs/notes/am62p-direct-boot.md, "The second stage").
# The defaults are the Verdin AM62P's: keep them in step with the overlay
# (boards/verdin_am62p_am62p54_a53.overlay) and tools/am62p-mkboot.py.

menu "boot_stage2"

choice BOOT_STAGE2_SOURCE
	prompt "Where the image comes from"
	default BOOT_STAGE2_SOURCE_EMBEDDED

config BOOT_STAGE2_SOURCE_EMBEDDED
	bool "Carried inside this loader (-DBOOT_STAGE2_PAYLOAD=<stage2 .img> at build time)"
	help
	  The whole boot image is the loader plus the compressed payload, so
	  it fits the boot loader's slot (the AM62P's 1.49 MiB u-boot.img slot,
	  the i.MX8MP's 3.5 MiB) and nothing is written to the eMMC user area.
	  No storage driver runs: the payload is inflated from the loader's own
	  .rodata to BOOT_STAGE2_LOAD.

config BOOT_STAGE2_SOURCE_EMMC
	bool "A raw sector range of the eMMC user area (the AM62P's MMC0)"
	help
	  For an image whose compressed form does not fit the slot: the loader
	  reads it from BOOT_STAGE2_SECTOR of the user area with Zephyr's SD
	  stack (prj_emmc.conf).

endchoice

config BOOT_STAGE2_DISK
	string "Disk name of the eMMC (the zephyr,mmc-disk node's disk-name)"
	default "emmc"

config BOOT_STAGE2_SECTOR
	int "User-area sector of the image header"
	default 64
	help
	  The header sector; the stored payload follows it. 64 (32 KiB) leaves
	  sector 0 (the DOS partition table) and the room a GPT would take
	  (sectors 1-33) alone. am62p-mkboot.py STAGE2_SECTOR.

config BOOT_STAGE2_END_SECTOR
	int "First user-area sector the image must not reach"
	default 8192
	help
	  The start of the first partition on the board's eMMC (Torizon:
	  mmcblk0p1 at 8192, read with "sfdisk -d /dev/mmcblk0" on 2026-10-02).
	  am62p-mkboot.py STAGE2_END_SECTOR.

config BOOT_STAGE2_LOAD
	hex "Load address of the image"
	default 0x48000000 if BOARD_VERDIN_IMX8MP
	default 0x82000000
	help
	  The only load address the loader serves: the direct images are
	  linked there (verdin_am62p/am62p54/a53/direct at 0x82000000,
	  verdin_imx8mp/mimx8ml8/a53/direct at 0x48000000).

config BOOT_STAGE2_STAGING
	hex "Where a compressed payload is read before it is inflated (eMMC source); the image's size bound"
	default 0x50000000 if BOARD_VERDIN_IMX8MP
	default 0x90000000
	help
	  Inside the mapped region (the overlay's stage2_payload node), above
	  the largest image (it bounds a version 1 or 2 image: STAGING - LOAD
	  bytes) and below the region's end with room for the largest payload
	  the user-area range holds. A version-3 (segment table) payload's
	  segments may lie anywhere in the region except STAGING .. STAGING +
	  the range's bytes (eMMC source). With the default 0x90000000 the
	  AM62P showcase's R5F segments at 0x90000000 would collide, so its
	  loader moves the staging buffer above them (am62p-mkboot.py stage2img
	  --staging checks the same rule).

config BOOT_STAGE2_REGION_END
	hex "End of the mapped region (exclusive)"
	default 0x58000000 if BOARD_VERDIN_IMX8MP
	default 0x97800000
	help
	  The overlay's stage2_payload node ends here (the GPU carveout).

config BOOT_STAGE2_PROGRESS_LOG
	bool "Log each step on the console, with a memory bandwidth probe"
	default y
	help
	  The header, the read and unpack times, and a timed 1 MiB copy. The
	  console is polled, so every line costs its length at the UART's
	  rate before the image runs (at 115200 baud, about 87 us a
	  character: the four lines and the probe were 31 ms of the i.MX8MP
	  loader's 300, 2026-10-29; with the Zephyr banner and the SD stack's
	  information lines, 0.09 s of the AM62P eMMC loader's 0.28,
	  2026-11-12). Errors are always printed. Off, the loader also does not
	  wait for the UART to drain before the jump; quiet.conf turns the
	  banner and the SD stack's information lines off with it.

config BOOT_STAGE2_SUMMARY_LINE
	bool "Without the progress log, one short line of times before the jump"
	depends on !BOOT_STAGE2_PROGRESS_LOG
	help
	  "bs2: <ready> <read> <unpack> <zero thread>/<waited for it> ms
	  @<system counter at main()> us": the milliseconds until the source
	  was ready, of the reads and of the unpack, those the zero thread took
	  from its start to its end and those main() then waited for it (0/0
	  without a zero range), and where the loader began on the clock the
	  stages before and after it use. About 30 characters, 3 ms at 115200
	  baud. For a board whose image does not read the loader's stamps
	  (src/main.c, bs2_stamps_publish): the Verdin AM62P, quiet.conf. The
	  i.MX8MP loader stays silent.

config BOOT_STAGE2_CHUNK_SECTORS
	int "Sectors per disk read"
	default 2048

config BOOT_STAGE2_RESTART
	bool "Entered again after the A53 image's SYSTEM_SUSPEND (route 3)"
	default y if BOARD_VERDIN_IMX8MP
	help
	  The A53 image suspends to this loader's entry point
	  (CLUSTER_A53_RESTART_ENTRY, cluster/a53_power.h) and TF-A resumes core
	  0 there with the loader's RAM as the first run left it. The loader
	  then restores its initialised RAM data from the copy taken on the
	  first entry (src/main.c, "Every entry is a first entry") and, when
	  the power page says so, stamps a53_loader_in. The page's address is
	  the i.MX 8M Plus route 3's (the M7's non-cacheable window).

endmenu

source "Kconfig.zephyr"
