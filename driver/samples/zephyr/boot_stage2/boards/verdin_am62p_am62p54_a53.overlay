/*
 * SPDX-License-Identifier: Apache-2.0
 * SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
 *
 * The second-stage loader on the Verdin AM62P A53 (docs/direct-boot.md,
 * "The second stage"). Three changes to the a53 board:
 *
 * 1. Its own RAM, 0x80800000 + 24 MiB: the A53 SPL loads it there (U-Boot
 *    proper's load address in Toradex's u-boot.img; the SPL's text, BSS at
 *    0x80c80000 and stack/malloc below 0x82000000 are dead once it runs,
 *    and the file itself, with the devicetree the SPL appends, ends far
 *    below 0x80c80000). It ends where the image it loads begins.
 *
 * 2. The image's region, 0x82000000 .. 0x97800000 (the a53 board's
 *    zephyr,sram, up to the GPU carveout), identity mapped write-back
 *    cacheable so the loader can read and inflate into it at the physical
 *    addresses the image is linked at. Kconfig BOOT_STAGE2_LOAD/_STAGING/
 *    _REGION_END lie in it.
 *
 * 3. The eMMC: MMC0 (main_sdhci0, 8 bit), as Linux's
 *    k3-am62p-j722s-common-main.dtsi describes it for the AM62P
 *    ("ti,am64-sdhci-8bit": a PHY with a DLL, no pin mux of its own) and
 *    k3-am62p-verdin.dtsi (50 ohm drive). Zephyr's k3-am62-main.dtsi has the
 *    AM62x's values; the AM62P's taps and trim replace them. No HS200: the
 *    loader reads a few MB, and HS (52 MHz) needs neither tuning nor the
 *    DLL lock. The GPU is off.
 *
 * 4. MMC0 (TISCI device 57, Linux's power-domains = <&k3_pds 57>) switched on
 *    through TISCI first: after an eMMC boot the SPLs left it on, after a USB
 *    (DFU) boot nobody did.
 */

#include <mem.h>
#include <zephyr/dt-bindings/memory-attr/memory-attr-arm64.h>

/ {
	chosen {
		zephyr,sram = &stage2_ram;
	};

	stage2_ram: memory@80800000 {
		reg = <0x80800000 DT_SIZE_M(24)>;
	};

	stage2_payload: memory@82000000 {
		compatible = "zephyr,memory-region";
		reg = <0x82000000 DT_SIZE_M(344)>;
		zephyr,memory-region = "STAGE2_PAYLOAD";
		zephyr,memory-attr = <(DT_MEM_ARM64(ATTR_ARM64_CACHE_WB))>;
	};
};

&gpu {
	status = "disabled";
};

&tisci_power_on {
	devices = <57>;
	status = "okay";
};

&main_sdhci0 {
	/delete-property/ mmc-hs200-1_8v;
	ti,dll-present;
	ti,trm-icp = <0x8>;
	ti,driver-strength-ohm = <50>;
	ti,clkbuf-sel = <0x7>;
	ti,otap-del-sel-legacy = <0x1>;
	ti,itap-del-sel-legacy = <0x10>;
	ti,otap-del-sel-hs = <0x1>;
	ti,itap-del-sel-hs = <0xa>;
	ti,otap-del-sel-ddr52 = <0x6>;
	ti,itap-del-sel-ddr52 = <0x3>;
	ti,otap-del-sel-hs200 = <0x8>;
	status = "okay";

	mmc {
		compatible = "zephyr,mmc-disk";
		bus-width = <8>;
		disk-name = "emmc";
		status = "okay";
	};
};
