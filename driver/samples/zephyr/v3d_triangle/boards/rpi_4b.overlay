/*
 * The board's sram0 is 512 KiB at 0x200000 (dts/arm64/broadcom/bcm2711.dtsi);
 * the GPU buffers of this sample need more. DRAM starts at 0 on the Pi 4, and
 * the firmware keeps its own memory at the top of the first GiB, so 32 MiB from
 * 0x200000 is ARM memory on every Pi 4.
 */
#include "../../common/rpi_4b_sram.dtsi"

&sram0 {
	reg = <0x200000 0x2000000>;
};
