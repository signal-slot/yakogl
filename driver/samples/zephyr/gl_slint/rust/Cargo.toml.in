# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
# Generated by CMake (configure_file); @VAR@ are substituted at configure time.
#
# The Slint application staticlib for the Zephyr image: the meter cluster UI
# (../ui/cluster.slint, compiled by build.rs) drawn through Slint's FemtoVG
# OpenGL ES 2.0 renderer on YakoGL, plus the Zephyr runtime glue (allocator,
# panic handler). SLINT_NOSTD_DIR points at the no_std Slint workspace (the
# patched core/common/renderer + the trimmed facade); it lives outside the repo
# (a large multi-crate checkout), so the path is injected rather than committed.

[package]
name = "slint_zephyr"
version = "0.0.0"
edition = "2021"
build = "@CARGO_SRC@/build.rs"

[lib]
path = "@CARGO_SRC@/src/lib.rs"
crate-type = ["staticlib"]

[dependencies]
slint = { path = "@SLINT_NOSTD_DIR@/api/rs/slint", default-features = false, features = ["compat-1-2", "unsafe-single-threaded", "libm"] }
i-slint-renderer-femtovg = { path = "@SLINT_NOSTD_DIR@/internal/renderers/femtovg", default-features = false, features = ["opengl"] }
i-slint-core = { path = "@SLINT_NOSTD_DIR@/internal/core", default-features = false, features = ["libm", "unsafe-single-threaded"] }

[build-dependencies]
# renderer-software: EmbedForSoftwareRenderer pre-renders the fonts (bitmap glyphs)
# and decodes the images at compile time; the no_std target has neither a font
# stack nor an image decoder at run time.
slint-build = { path = "@SLINT_NOSTD_DIR@/api/rs/build", default-features = false, features = ["compat-1-18", "renderer-software"] }

[profile.release]
panic = "abort"
opt-level = "z"

[profile.dev]
panic = "abort"

# Own workspace root: do not attach to any Cargo workspace above the build dir.
[workspace]

# The Slint FemtoVG renderer depends on femtovg/glow from crates.io, which are
# not no_std. Redirect them to the no_std forks (the same ones gl_femtovg uses);
# the Slint workspace does this too, but this crate is its own workspace.
[patch.crates-io]
femtovg = { path = "@NOSTD_PATCH_DIR@/femtovg" }
glow = { path = "@NOSTD_PATCH_DIR@/glow" }
