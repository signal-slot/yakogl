+// no_std (alloc-only) probe proving the Slint FemtoVG renderer public API wires up
+// with i-slint-core built in its minimal no_std configuration (no text, no images).
+// Builds for the HOST but with #![no_std]; a stub global allocator provides `alloc`.
+// The functions below only need to typecheck + codegen; calling them would fault
+// (get_proc_address returns null), so they are never invoked.
+#![no_std]
+
+extern crate alloc;
+
+use alloc::boxed::Box;
+use core::alloc::{GlobalAlloc, Layout};
+use core::ffi::{CStr, c_void};
+use core::num::NonZeroU32;
+use core::ptr::null_mut;
+
+/// Trivial never-actually-used allocator so the crate can pull in `alloc`.
+struct StubAlloc;
+unsafe impl GlobalAlloc for StubAlloc {
+    unsafe fn alloc(&self, _l: Layout) -> *mut u8 {
+        null_mut()
+    }
+    unsafe fn dealloc(&self, _p: *mut u8, _l: Layout) {}
+}
+#[global_allocator]
+static A: StubAlloc = StubAlloc;
+
+use i_slint_core::Brush;
+use i_slint_core::Color;
+use i_slint_renderer_femtovg::FemtoVGOpenGLRenderer;
+use i_slint_renderer_femtovg::opengl::OpenGLInterface;
+
+type BoxErr = Box<dyn core::error::Error + Send + Sync>;
+
+/// Stub OpenGL context: every entry point is a no-op / null. Only needs to COMPILE.
+struct NullGl;
+
+#[allow(unsafe_code)]
+unsafe impl OpenGLInterface for NullGl {
+    fn ensure_current(&self) -> Result<(), BoxErr> {
+        Ok(())
+    }
+    fn swap_buffers(&self) -> Result<(), BoxErr> {
+        Ok(())
+    }
+    fn resize(&self, _width: NonZeroU32, _height: NonZeroU32) -> Result<(), BoxErr> {
+        Ok(())
+    }
+    fn get_proc_address(&self, _name: &CStr) -> *const c_void {
+        null_mut::<c_void>() as *const c_void
+    }
+}
+
+/// Construct a FemtoVG OpenGL renderer through the public Slint API, no_std.
+/// Proves the whole renderer + i-slint-core (minimal features) wiring compiles.
+pub fn make_renderer() -> Result<FemtoVGOpenGLRenderer, i_slint_core::platform::PlatformError> {
+    FemtoVGOpenGLRenderer::new(NullGl)
+}
+
+/// Reference the item / brush / geometry types used to describe a coloured
+/// Rectangle scene, proving those parts of the API are reachable no_std.
+/// (A full item tree is produced by the Slint compiler macro, which is out of
+/// scope for a hand-written compile probe.)
+pub fn describe_coloured_rectangle() -> (Brush, i_slint_core::lengths::LogicalRect) {
+    let brush = Brush::SolidColor(Color::from_rgb_u8(0x33, 0x88, 0xff));
+    let rect = i_slint_core::lengths::LogicalRect::new(
+        i_slint_core::lengths::LogicalPoint::new(0.0, 0.0),
+        i_slint_core::lengths::LogicalSize::new(100.0, 40.0),
+    );
+    (brush, rect)
+}
