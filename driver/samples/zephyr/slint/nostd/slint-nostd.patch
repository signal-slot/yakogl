@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: Apache-2.0
+// Compile the cluster UI at build time. slint-build runs the Slint compiler on the
+// host and writes generated Rust into OUT_DIR, pulled in by slint::include_modules!()
+// in src/lib.rs.
+//
+// EmbedForSoftwareRenderer pre-renders every font/size the .slint files use into
+// bitmap fonts (registered by the generated code) and decodes images into raw
+// textures: the no_std target has neither a font stack nor an image decoder, so
+// both come from the compiler, the same way Slint runs on MCUs.
+fn main() {
+    println!("cargo:rerun-if-changed=ui-cluster/cluster.slint");
+    println!("cargo:rerun-if-changed=ui-cluster/theme.slint");
+    println!("cargo:rerun-if-changed=ui-cluster/gauge-parts.slint");
+    let config = slint_build::CompilerConfiguration::new()
+        .embed_resources(slint_build::EmbedResourcesKind::EmbedForSoftwareRenderer);
+    slint_build::compile_with_config("ui-cluster/cluster.slint", config)
+        .expect("Slint compile failed");
+}
--- a/slint-ui-app/src/lib.rs
+++ b/slint-ui-app/src/lib.rs
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: Apache-2.0
+//! no_std (alloc-only) Slint application staticlib for aarch64-unknown-none.
+//!
+//! Draws one real Slint frame (the item tree compiled from `ui/app.slint`)
+//! through Slint's FemtoVG (OpenGL ES 2.0) renderer, over an app-supplied GL
+//! context (libGLES2 + EGL on the PowerVR driver). The C side creates and makes
+//! current a GL context and passes a get-proc-address function pointer; we
+//! install a custom `slint::platform::Platform` whose `WindowAdapter` owns a
+//! `FemtoVGOpenGLRenderer` built over that context, instantiate the compiled
+//! component, and render. The compiled UI is the real `apps/cluster` meter
+//! cluster (MainWindow): its PNG assets are embedded as StaticTextures at build
+//! time (build.rs, EmbedForSoftwareRenderer) and drawn as GPU textures. Text is
+//! still pending (Slint's font stack is std-bound and disabled).
+#![no_std]
+
+extern crate alloc;
+
+use alloc::boxed::Box;
+use alloc::rc::{Rc, Weak};
+use core::cell::UnsafeCell;
+use core::ffi::{c_char, c_void, CStr};
+use core::num::NonZeroU32;
+
+use slint::platform::{Platform, Renderer, WindowAdapter};
+use slint::{ComponentHandle, PhysicalSize, PlatformError, Window};
+
+use i_slint_renderer_femtovg::opengl::OpenGLInterface;
+use i_slint_renderer_femtovg::FemtoVGOpenGLRenderer;
+
+// The Slint compiler output (from build.rs / ui/app.slint). Exports `AppWindow`.
+slint::include_modules!();
+
+// ---------------------------------------------------------------------------
+// Standalone-build support: global allocator stub + panic handler.
+//
+// A real Zephyr link supplies its own allocator and panic handler, so these are
+// gated out when the `external_rt` feature is set (the integrator provides them).
+// For the standalone `aarch64-unknown-none` staticlib we must define both or the
+// crate will not link on its own. They are intentionally minimal placeholders.
+// ---------------------------------------------------------------------------
+#[cfg(not(feature = "external_rt"))]
+mod standalone_rt {
+    use core::alloc::{GlobalAlloc, Layout};
+    use core::ptr::null_mut;
+
+    struct StubAlloc;
+    unsafe impl GlobalAlloc for StubAlloc {
+        unsafe fn alloc(&self, _l: Layout) -> *mut u8 {
+            null_mut()
+        }
+        unsafe fn dealloc(&self, _p: *mut u8, _l: Layout) {}
+    }
+    #[global_allocator]
+    static A: StubAlloc = StubAlloc;
+
+    #[panic_handler]
+    fn panic(_info: &core::panic::PanicInfo) -> ! {
+        loop {
+            core::hint::spin_loop();
+        }
+    }
+}
+
+type GetProc = extern "C" fn(*const c_char) -> *const c_void;
+
+/// Build a Slint image from raw RGBA8 bytes (w*h*4). The cluster's PNGs are
+/// decoded to raw RGBA on the host at build time; the no_std target has no
+/// runtime image decoder, so `Image::from_rgba8` uploads these pixels directly.
+fn rgba_image(bytes: &'static [u8], w: u32, h: u32) -> slint::Image {
+    let mut buf = slint::SharedPixelBuffer::<slint::Rgba8Pixel>::new(w, h);
+    buf.make_mut_bytes().copy_from_slice(bytes);
+    slint::Image::from_rgba8(buf)
+}
+
+// ---------------------------------------------------------------------------
+// Single-threaded process state.
+//
+// Slint is used here under the `unsafe-single-threaded` contract: the C side
+// calls `slint_draw_frame` from exactly one thread. `Single` is a Sync wrapper
+// around that state (the platform, the live component, the window adapter and
+// the get-proc hook) so we can hold non-Send types (`Rc`, `AppWindow`) in a
+// `static` without pulling in `std::thread_local!`.
+// ---------------------------------------------------------------------------
+struct Single<T>(UnsafeCell<T>);
+// Safety: only ever accessed from the single UI thread (see module docs).
+unsafe impl<T> Sync for Single<T> {}
+impl<T> Single<T> {
+    const fn new(v: T) -> Self {
+        Single(UnsafeCell::new(v))
+    }
+    #[allow(clippy::mut_from_ref)]
+    unsafe fn get(&self) -> &mut T {
+        &mut *self.0.get()
+    }
+}
+
+struct State {
+    get_proc: Option<GetProc>,
+    adapter: Option<Rc<AppWindowAdapter>>,
+    ui: Option<MainWindow>,
+    platform_set: bool,
+}
+
+static STATE: Single<State> = Single::new(State {
+    get_proc: None,
+    adapter: None,
+    ui: None,
+    platform_set: false,
+});
+
+type BoxErr = Box<dyn core::error::Error + Send + Sync>;
+
+/// OpenGL ES 2.0 context bridge: forward every entry-point lookup to the C hook.
+/// The C side has made the context current before calling `slint_draw_frame`,
+/// so `ensure_current` is a no-op; the caller presents the frame after we return.
+struct GlContext;
+
+#[allow(unsafe_code)]
+unsafe impl OpenGLInterface for GlContext {
+    fn ensure_current(&self) -> Result<(), BoxErr> {
+        Ok(())
+    }
+    fn swap_buffers(&self) -> Result<(), BoxErr> {
+        Ok(())
+    }
+    fn resize(&self, _width: NonZeroU32, _height: NonZeroU32) -> Result<(), BoxErr> {
+        Ok(())
+    }
+    fn get_proc_address(&self, name: &CStr) -> *const c_void {
+        // Safety: single-threaded; get_proc is set before the platform is used.
+        match unsafe { STATE.get() }.get_proc {
+            Some(f) => f(name.as_ptr()),
+            None => core::ptr::null(),
+        }
+    }
+}
+
+/// Window adapter owning the FemtoVG renderer. `renderer()` hands Slint the
+/// renderer for this window; `size()` reports the fixed drawable size.
+struct AppWindowAdapter {
+    window: Window,
+    renderer: FemtoVGOpenGLRenderer,
+    size: PhysicalSize,
+}
+
+impl WindowAdapter for AppWindowAdapter {
+    fn window(&self) -> &Window {
+        &self.window
+    }
+    fn size(&self) -> PhysicalSize {
+        self.size
+    }
+    fn renderer(&self) -> &dyn Renderer {
+        &self.renderer
+    }
+}
+
+/// Custom platform: builds our FemtoVG window adapter. No event loop, no default
+/// backend — the application drives a single render per `slint_draw_frame`.
+struct AppPlatform {
+    size: PhysicalSize,
+}
+
+impl Platform for AppPlatform {
+    fn create_window_adapter(&self) -> Result<Rc<dyn WindowAdapter>, PlatformError> {
+        let renderer = FemtoVGOpenGLRenderer::new(GlContext)?;
+        let size = self.size;
+        let adapter = Rc::new_cyclic(|weak: &Weak<AppWindowAdapter>| AppWindowAdapter {
+            window: Window::new(weak.clone()),
+            renderer,
+            size,
+        });
+        // Keep a strong handle so we can drive render() outside an event loop.
+        // Safety: single-threaded (see module docs).
+        unsafe { STATE.get() }.adapter = Some(adapter.clone());
+        Ok(adapter)
+    }
+
+    // Required: the default panics ("must implement duration_since_start"). We
+    // render a single static frame with no animations, so a fixed zero-time
+    // clock is correct here. (Wire a real monotonic source, e.g. Zephyr
+    // k_uptime, if animated content is added later.)
+    fn duration_since_start(&self) -> core::time::Duration {
+        core::time::Duration::ZERO
+    }
+}
+
+/// Draw one Slint frame through the caller's current GL ES 2.0 context.
+///
+/// `get_proc` is the app's get-proc-address hook (EGL/GLES style). `width`/
+/// `height` are the drawable size in pixels. Returns 0 on success, non-zero on
+/// failure (1: set_platform, 2: component build, 3: show, 4: no adapter,
+/// 5: render).
+#[no_mangle]
+pub extern "C" fn slint_draw_frame(get_proc: GetProc, width: u32, height: u32) -> i32 {
+    // Safety: single-threaded; STATE is only touched from this thread.
+    let state = unsafe { STATE.get() };
+    state.get_proc = Some(get_proc);
+
+    let size = PhysicalSize::new(width, height);
+
+    if !state.platform_set {
+        if slint::platform::set_platform(Box::new(AppPlatform { size })).is_err() {
+            return 1;
+        }
+        state.platform_set = true;
+    }
+
+    if state.ui.is_none() {
+        match MainWindow::new() {
+            Ok(ui) => {
+                // Pre-decoded RGBA assets (host build-time decode), fed as images.
+                ui.set_bg_image(rgba_image(
+                    include_bytes!("../ui-cluster/assets/cluster-bg.rgba"), 1024, 600));
+                ui.set_logo_image(rgba_image(
+                    include_bytes!("../ui-cluster/assets/slint-logo.rgba"), 330, 132));
+                // A live-ish pose so the needles deflect and the power bar fills.
+                ui.set_engine_on(true);
+                ui.set_speed_x10(1234);
+                ui.set_rpm(3200);
+                state.ui = Some(ui);
+            }
+            Err(_) => return 2,
+        }
+    }
+
+    let ui = state.ui.as_ref().unwrap();
+    ui.window().set_size(size);
+    if ui.show().is_err() {
+        return 3;
+    }
+
+    let adapter = match state.adapter.as_ref() {
+        Some(a) => a,
+        None => return 4,
+    };
+    if adapter.renderer.render().is_err() {
+        return 5;
+    }
+    0
+}
