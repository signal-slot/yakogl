+// Copyright © SixtyFPS GmbH <info@slint.dev>
+// SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-Slint-Royalty-free-2.0 OR LicenseRef-Slint-Software-3.0
+
+//! no_std text for the FemtoVG renderer.
+//!
+//! Slint's text stack for this renderer (parley/fontique/skrifa) needs `std`, so on
+//! no_std targets the glyphs come from the same source the software renderer uses on
+//! MCUs: fonts pre-rendered at compile time by the Slint compiler
+//! (`EmbedResourcesKind::EmbedForSoftwareRenderer`) and registered by the generated
+//! code through `Renderer::register_bitmap_font`. This module holds that registry and a
+//! `PixelFont` that plugs a `BitmapFont` into `i_slint_core::textlayout`, mirroring
+//! `i_slint_renderer_software::fonts::pixelfont`. The item renderer composes the glyph
+//! alpha maps into a small RGBA texture per Text item and draws it like an image.
+
+use alloc::vec::Vec;
+use core::cell::RefCell;
+
+use i_slint_core::graphics::euclid;
+use i_slint_core::graphics::{BitmapFont, BitmapGlyph, BitmapGlyphs, FontRequest};
+use i_slint_core::lengths::{PhysicalPx, ScaleFactor};
+use i_slint_core::textlayout::{FontMetrics, Glyph, TextLayout, TextShaper, DEFAULT_FONT_SIZE};
+
+/// Integer pixel length used by the bitmap-font layout (the software renderer's unit).
+pub type FontLength = euclid::Length<i16, PhysicalPx>;
+
+i_slint_core::thread_local! {
+    static BITMAP_FONTS: RefCell<Vec<&'static BitmapFont>> = RefCell::default()
+}
+
+pub fn register_bitmap_font(font_data: &'static BitmapFont) {
+    BITMAP_FONTS.with(|fonts| fonts.borrow_mut().push(font_data))
+}
+
+/// A registered font resolved to one of its pre-rendered pixel sizes.
+pub struct PixelFont {
+    pub bitmap_font: &'static BitmapFont,
+    pub glyphs: &'static BitmapGlyphs,
+    /// The pixel size the text asked for. The glyph set is the nearest pre-rendered
+    /// size not larger than it; `scale()` maps the glyph set to this size.
+    pub pixel_size: FontLength,
+}
+
+impl PixelFont {
+    fn glyph_index_to_glyph_id(index: usize) -> core::num::NonZeroU16 {
+        core::num::NonZeroU16::new(index as u16 + 1).unwrap()
+    }
+
+    fn glyph_id_to_glyph_index(id: core::num::NonZeroU16) -> usize {
+        id.get() as usize - 1
+    }
+
+    /// The pre-rendered glyph for a glyph id from `shape_text`, or None for glyphs
+    /// without ink (a space).
+    pub fn bitmap_glyph(&self, glyph_id: core::num::NonZeroU16) -> Option<&'static BitmapGlyph> {
+        let glyph = &self.glyphs.glyph_data[Self::glyph_id_to_glyph_index(glyph_id)];
+        (!glyph.data.is_empty()).then_some(glyph)
+    }
+
+    /// Target pixels per pre-rendered glyph pixel (1.0 when the requested size was
+    /// pre-rendered, which is the normal case since the compiler embeds every size a
+    /// .slint file uses).
+    pub fn scale(&self) -> f32 {
+        self.pixel_size.get() as f32 / self.glyphs.pixel_size as f32
+    }
+
+    fn advance_for(&self, glyph: &BitmapGlyph) -> FontLength {
+        ((self.pixel_size.cast::<i32>() * glyph.x_advance as i32 / self.glyphs.pixel_size as i32
+            + euclid::Length::new(32))
+            / 64)
+            .cast()
+    }
+}
+
+impl TextShaper for PixelFont {
+    type LengthPrimitive = i16;
+    type Length = FontLength;
+
+    fn shape_text<GlyphStorage: core::iter::Extend<Glyph<FontLength>>>(
+        &self,
+        text: &str,
+        glyphs: &mut GlyphStorage,
+    ) {
+        let glyphs_iter = text.char_indices().map(|(byte_offset, ch)| {
+            let glyph_index = self
+                .bitmap_font
+                .character_map
+                .binary_search_by_key(&ch, |entry| entry.code_point)
+                .ok()
+                .map(|i| self.bitmap_font.character_map[i].glyph_index as usize);
+            let advance = glyph_index
+                .map_or(self.pixel_size, |i| self.advance_for(&self.glyphs.glyph_data[i]));
+            Glyph {
+                glyph_id: glyph_index.map(Self::glyph_index_to_glyph_id),
+                advance,
+                text_byte_offset: byte_offset,
+                ..Default::default()
+            }
+        });
+        glyphs.extend(glyphs_iter);
+    }
+
+    fn glyph_for_char(&self, ch: char) -> Option<Glyph<FontLength>> {
+        self.bitmap_font
+            .character_map
+            .binary_search_by_key(&ch, |entry| entry.code_point)
+            .ok()
+            .map(|i| {
+                let glyph_index = self.bitmap_font.character_map[i].glyph_index as usize;
+                Glyph {
+                    glyph_id: Some(Self::glyph_index_to_glyph_id(glyph_index)),
+                    advance: self.advance_for(&self.glyphs.glyph_data[glyph_index]),
+                    text_byte_offset: 0,
+                    ..Default::default()
+                }
+            })
+    }
+
+    fn max_lines(&self, max_height: FontLength) -> usize {
+        (max_height / self.height()).get() as _
+    }
+}
+
+impl FontMetrics<FontLength> for PixelFont {
+    fn ascent(&self) -> FontLength {
+        (self.pixel_size.cast::<f32>() * self.bitmap_font.ascent / self.bitmap_font.units_per_em)
+            .cast()
+    }
+
+    fn descent(&self) -> FontLength {
+        (self.pixel_size.cast::<f32>() * self.bitmap_font.descent / self.bitmap_font.units_per_em)
+            .cast()
+    }
+
+    fn height(&self) -> FontLength {
+        // The descent is negative (relative to the baseline)
+        (self.pixel_size.cast::<f32>() * (self.bitmap_font.ascent - self.bitmap_font.descent)
+            / self.bitmap_font.units_per_em)
+            .cast()
+    }
+
+    fn x_height(&self) -> FontLength {
+        (self.pixel_size.cast::<f32>() * self.bitmap_font.x_height / self.bitmap_font.units_per_em)
+            .cast()
+    }
+
+    fn cap_height(&self) -> FontLength {
+        (self.pixel_size.cast::<f32>() * self.bitmap_font.cap_height
+            / self.bitmap_font.units_per_em)
+            .cast()
+    }
+}
+
+/// Picks the registered bitmap font closest to the request (family, italic, weight)
+/// and its pre-rendered size closest to the requested pixel size. None when no font
+/// was registered: the .slint files were compiled without `EmbedForSoftwareRenderer`.
+pub fn match_font(request: &FontRequest, scale_factor: ScaleFactor) -> Option<PixelFont> {
+    let requested_weight: u16 =
+        request.weight.and_then(|w| w.try_into().ok()).unwrap_or(/* CSS normal */ 400);
+
+    let font = BITMAP_FONTS.with(|fonts| {
+        let fonts = fonts.borrow();
+        let by_family = request.family.as_ref().and_then(|family| {
+            fonts
+                .iter()
+                .filter(|f| {
+                    core::str::from_utf8(f.family_name.as_slice()).unwrap_or("") == family.as_str()
+                        && f.italic == request.italic
+                })
+                .min_by_key(|f| f.weight.abs_diff(requested_weight))
+                .copied()
+        });
+        by_family.or_else(|| {
+            fonts
+                .iter()
+                .filter(|f| f.italic == request.italic)
+                .min_by_key(|f| f.weight.abs_diff(requested_weight))
+                .copied()
+                .or_else(|| fonts.first().copied())
+        })
+    })?;
+
+    let requested_pixel_size: FontLength =
+        (request.pixel_size.unwrap_or(DEFAULT_FONT_SIZE).cast::<f32>() * scale_factor).cast();
+
+    let nearest = font
+        .glyphs
+        .partition_point(|glyphs| glyphs.pixel_size <= requested_pixel_size.get())
+        .saturating_sub(1);
+    let glyphs = font.glyphs.get(nearest)?;
+
+    Some(PixelFont { bitmap_font: font, glyphs, pixel_size: requested_pixel_size })
+}
+
+pub fn text_layout_for_font<'a>(
+    font: &'a PixelFont,
+    font_request: &FontRequest,
+    scale_factor: ScaleFactor,
+) -> TextLayout<'a, PixelFont> {
+    let letter_spacing =
+        font_request.letter_spacing.map(|spacing| (spacing.cast::<f32>() * scale_factor).cast());
+    TextLayout { font, letter_spacing }
+}
+
+/// Lays out `string` inside a `target`-sized box and composes the glyph alpha maps,
+/// tinted with `color`, into a premultiplied RGBA8 buffer. None when the text has no
+/// ink or no bitmap font is registered. The buffer is what the item renderer uploads
+/// as the Text item's texture.
+///
+/// The buffer is not the whole box: it is cut to the pixels with ink plus a
+/// transparent margin, and the second value is where it starts in the box. A Text
+/// item is laid out in a box often much larger than its text (a centred label 400 px
+/// wide holding one letter), and every pixel of the box would be a fragment the GPU
+/// shades and blends to no effect (gc_slint route 3: 458 000 of the 856 000 pixels a
+/// frame drew were text quads). The cut is rounded out to a multiple of
+/// [`CROP_STEP_X`] x [`CROP_STEP_Y`] so that a text whose ink changes width by a
+/// few pixels keeps its texture size, and the texture can be refilled in place.
+#[allow(clippy::too_many_arguments)]
+pub fn compose_text(
+    string: &str,
+    font_request: &FontRequest,
+    scale_factor: ScaleFactor,
+    color: i_slint_core::Color,
+    target: euclid::Size2D<f32, PhysicalPx>,
+    horizontal_alignment: i_slint_core::items::TextHorizontalAlignment,
+    vertical_alignment: i_slint_core::items::TextVerticalAlignment,
+    wrap: i_slint_core::items::TextWrap,
+    overflow: i_slint_core::items::TextOverflow,
+    max_lines: Option<usize>,
+) -> Option<(i_slint_core::graphics::SharedPixelBuffer<i_slint_core::graphics::Rgba8Pixel>, (i32, i32))>
+{
+    use i_slint_core::textlayout::TextParagraphLayout;
+
+    if string.trim().is_empty() || color.alpha() == 0 {
+        return None;
+    }
+    let font = match_font(font_request, scale_factor)?;
+    let width = num_traits::Float::ceil(target.width).max(1.) as usize;
+    let height = num_traits::Float::ceil(target.height).max(1.) as usize;
+    if width > i16::MAX as usize || height > i16::MAX as usize {
+        return None;
+    }
+
+    let layout = text_layout_for_font(&font, font_request, scale_factor);
+    let paragraph = TextParagraphLayout {
+        string,
+        layout,
+        max_width: FontLength::new(width as i16),
+        max_height: FontLength::new(height as i16),
+        horizontal_alignment,
+        vertical_alignment,
+        wrap,
+        overflow,
+        single_line: false,
+        max_lines,
+    };
+
+    let mut buffer = i_slint_core::graphics::SharedPixelBuffer::<
+        i_slint_core::graphics::Rgba8Pixel,
+    >::new(width as u32, height as u32);
+    let (cr, cg, cb, ca) =
+        (color.red() as u32, color.green() as u32, color.blue() as u32, color.alpha() as u32);
+    let scale = font.scale();
+    let ascent = font.ascent();
+    let pixels = buffer.make_mut_slice();
+    // the pixels with ink, as [x0, x1) x [y0, y1)
+    let mut ink = [i32::MAX, i32::MAX, i32::MIN, i32::MIN];
+
+    let _ = paragraph.layout_lines::<()>(
+        |glyphs, line_x, line_y, _line, _selection| {
+            let baseline_y = (line_y + ascent).get() as f32;
+            for positioned in glyphs {
+                let Some(glyph) = font.bitmap_glyph(positioned.glyph_id) else { continue };
+                // Same placement as the software renderer: the glyph box ends `y/64`
+                // pixels above the baseline and starts `x/64` pixels right of the pen.
+                let gw = num_traits::Float::round(glyph.width as f32 * scale).max(1.) as i32;
+                let gh = num_traits::Float::round(glyph.height as f32 * scale).max(1.) as i32;
+                let left = num_traits::Float::round(
