--- a/internal/compiler/tests/syntax/analysis/binding_loop_shadowed.slint
+++ b/internal/compiler/tests/syntax/analysis/binding_loop_shadowed.slint
@@ -0,0 +1,17 @@
+// Copyright © SixtyFPS GmbH <info@slint.dev>
+// SPDX-License-Identifier: GPL-3.0-only OR LicenseRef-Slint-Royalty-free-2.0 OR LicenseRef-Slint-Software-3.0
+
+// A binding loop through a shadowing member must name it by its source name in the diagnostic,
+// not by the mangled internal name it is stored under.
