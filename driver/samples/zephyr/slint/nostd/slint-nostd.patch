+/// The cut of a composed text's box, as a multiple of these: see [`compose_text`].
+pub const CROP_STEP_X: i32 = 16;
+/// See [`CROP_STEP_X`].
+pub const CROP_STEP_Y: i32 = 4;
+
+/// The part of a `width` x `height` box to keep for ink at `ink` ([x0, y0, x1, y1)):
+/// the ink plus one transparent pixel on every side (the texture is sampled with
+/// linear filtering, so a quad that is not on whole pixels reads one texel past the
+/// ink), rounded out to the crop steps and kept inside the box. Returns x, y, width,
+/// height.
+fn crop_box(ink: [i32; 4], width: i32, height: i32) -> (i32, i32, i32, i32) {
+    let fit = |lo: i32, hi: i32, step: i32, size: i32| {
+        let lo = (lo - 1).max(0);
+        let hi = (hi + 1).min(size);
+        let len = ((hi - lo + step - 1) / step * step).min(size);
+        // grow to the right, or to the left where the box ends first
+        let start = lo.min(size - len);
+        (start, len)
+    };
+    let (x, w) = fit(ink[0], ink[2], CROP_STEP_X, width);
+    let (y, h) = fit(ink[1], ink[3], CROP_STEP_Y, height);
+    (x, y, w, h)
+}
+
+#[cfg(test)]
+mod crop_tests {
+    use super::crop_box;
+
+    #[test]
+    fn a_letter_in_a_wide_box_keeps_its_ink_and_a_margin() {
+        // a 20x26 letter centred in a 500x35 box
+        let (x, y, w, h) = crop_box([240, 4, 260, 30], 500, 35);
+        assert!(x <= 239 && x + w >= 261, "the ink and a pixel each side: {x} {w}");
+        assert!(y <= 3 && y + h >= 31, "{y} {h}");
+        assert_eq!(w % 16, 0);
+        assert_eq!(h % 4, 0);
+        assert!(w <= 48 && h <= 32);
+    }
+
+    #[test]
+    fn a_cut_at_the_box_edge_stays_inside_it() {
+        let (x, y, w, h) = crop_box([490, 0, 500, 35], 500, 35);
+        assert!(x >= 0 && x + w <= 500 && y >= 0 && y + h <= 35);
+        assert!(x <= 489);
+    }
+
+    #[test]
+    fn ink_over_the_whole_box_keeps_the_box() {
+        assert_eq!(crop_box([0, 0, 30, 10], 30, 10), (0, 0, 30, 10));
+    }
+}
