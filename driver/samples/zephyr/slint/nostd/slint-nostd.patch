+# SPDX-License-Identifier: Apache-2.0
+# no_std (alloc-only) Slint application staticlib for the PowerVR BXS-4-64 GPU.
+#
+# Renders a real Slint UI (compiled by slint-build from ui/app.slint) through
+# Slint's FemtoVG (OpenGL ES 2.0) renderer, over an app-supplied GL context
+# (libGLES2 + EGL on the driver). No text (Slint's parley/fontique text stack is
+# std-bound and disabled) and no external images; the UI uses only rectangles,
+# gradients, borders, rounded corners, drop-shadows, clipping and paths.
+[package]
+name = "slint-ui-app"
+version = "0.0.0"
+edition = "2021"
+
+[lib]
+path = "src/lib.rs"
+crate-type = ["rlib"]
+
+[features]
+# When set, the integrator (Zephyr) provides the global allocator and panic
+# handler; the crate omits its standalone placeholders (mirrors fvg_demo).
+external_rt = []
+
+[dependencies]
+slint = { workspace = true, default-features = false, features = ["compat-1-2", "unsafe-single-threaded", "libm"] }
+i-slint-renderer-femtovg = { workspace = true, default-features = false, features = ["opengl"] }
+i-slint-core = { workspace = true, default-features = false, features = ["libm", "unsafe-single-threaded"] }
+
+[build-dependencies]
+# renderer-software: EmbedForSoftwareRenderer (bitmap fonts + raw textures) for the no_std target
+slint-build = { workspace = true, features = ["renderer-software"] }
+
+[profile.release]
+panic = "abort"
+
+[profile.dev]
+panic = "abort"
