+    for k in 16: Rectangle {
+        property <float> t: k / 15.0;
+        property <length> r: 18px + (150px - 18px) * self.t;
+        property <length> d: 7px - 4px * self.t;   // taper 7px hub -> 3px tip
+        x: root.cx + r * sin(root.ang * 1deg) - self.d / 2;
+        y: root.cy - r * cos(root.ang * 1deg) - self.d / 2;
+        width: self.d; height: self.d; border-radius: self.d / 2;
+        background: root.ncol;
+    }
+}
+
+export component MainWindow inherits Window {
