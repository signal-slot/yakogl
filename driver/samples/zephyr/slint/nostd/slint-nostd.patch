@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: Apache-2.0
+//
+// Meter cluster for the Slint software renderer (no GPU) in the unprivileged
+// A53 app.  The SW renderer has no arc/Path support, so the static face (dial
+// rings, ticks, scale numbers, labels, frames, brand) is a baked image and the
+// dynamic parts are drawn by Slint on top: rotated needle images, animated,
+// plus live text.  Safety-critical readouts (speed number, gear, fuel level,
+// telltales, READY) are drawn by the R5F overlay and are NOT drawn here.
+import { Theme } from "theme.slint";
+
+// A needle without rotation (the SW renderer ignores Image/element rotation):
+// a tapered row of dots from the hub out to the rim, positioned by the value
+// angle.  angle = a0 + sweep * frac, measured clockwise from 12 o'clock.
+component Needle inherits Rectangle {
+    in property <length> cx;
+    in property <length> cy;
+    in property <float> frac;      // 0..1
+    in property <color> ncol;
+    property <float> ang: Theme.a0 + Theme.sweep * clamp(root.frac, 0, 1);
