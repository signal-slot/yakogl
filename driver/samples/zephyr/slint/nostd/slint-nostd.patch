+    ShadowsOptedIn {}
+    ShadowsDeprecated {}
+    ShadowsWithOtherKind {}
+    NotOptedIn {}
+    Leaf {}
+    NotOptedInLeaf {}
+    Twice {}
+    NotReserved {}
+    ShadowAndUnrelated {}
+    ShadowAndTwin {}
+    NoLeak {}
