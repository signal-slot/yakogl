+// SPDX-License-Identifier: Apache-2.0
+export global Theme {
+    out property <color> bg-top: #0b1018;
+    out property <color> bg-bot: #04060a;
+    out property <color> text: #f2f5f8;
+    out property <color> text2: #a8b2bd;
+    out property <color> dim: #6b7078;
+    out property <color> track: #141a22;
+    out property <color> accent: #6ea8ff;
+    out property <color> green: #4ade80;
+    out property <color> amber: #ffb02e;
+    // dial geometry (px), shared by both dials
+    out property <length> dial-r: 166px;
+    out property <length> face-r: 150px;
+    out property <length> left-cx: 214px;
+    out property <length> right-cx: 810px;
+    out property <length> dial-cy: 330px;
+    out property <float> a0: -140;      // sweep start (deg from 12 o'clock)
+    out property <float> sweep: 280;
+}
