+
+// The internal name of the shadow does not leak into the source namespace
+component NoLeak inherits Base {
+    in-out property <string> name: "Hey";
+//                           >  <warning{'name' shadows the inherited property of the same name}
+    out property <string> leak: root.name-1;
+//                                   >    <error{Element 'Base' does not have a property 'name-1'. Use space before the '-' if you meant a subtraction}
+}
+
+export component Test inherits Window {
+    b := Base {}
+    out property <string> from-base: b.name;
