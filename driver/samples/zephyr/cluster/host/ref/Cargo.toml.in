# SPDX-License-Identifier: Apache-2.0
# Generated by run.sh; @VAR@ are substituted there.
#
# The host reference render of the cluster sample: the same UI and state through
# Slint's software renderer, from an UNPATCHED Slint checkout at the commit the
# no_std tree is based on (SLINT_UPSTREAM_DIR; ../../../slint/nostd/README.md
# names it). The no_std patch trims the software renderer out of its tree.

[package]
name = "cluster_ref"
version = "0.0.0"
edition = "2021"
build = "@REF_SRC@/build.rs"

[[bin]]
name = "cluster_ref"
path = "@REF_SRC@/src/main.rs"

[dependencies]
slint = { path = "@SLINT_UPSTREAM_DIR@/api/rs/slint", default-features = false, features = ["std", "compat-1-2", "renderer-software", "software-renderer-path"] }
libm = "0.2"
# the checked frame's sequence (FRAME_TICKS, FRAME2_MS, FRAME3_MS), the one
# definition the image uses too
cluster-check = { package = "yakogl-cluster-check", path = "@CHECK_DIR@" }

[build-dependencies]
slint-build = { path = "@SLINT_UPSTREAM_DIR@/api/rs/build" }

[workspace]
