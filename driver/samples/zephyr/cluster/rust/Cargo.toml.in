# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
# Generated by CMake (configure_file); @VAR@ are substituted at configure time.
#
# The agl-slint-cluster staticlib for the cluster sample (driver/samples/
# zephyr/cluster, on the board layer): the cluster's UI
# (compiled by build.rs through ../ui/zephyr-cluster.slint) drawn through
# Slint's FemtoVG OpenGL ES 2.0 renderer on YakoGL, the cluster's application
# layer (src/cluster.rs) and the Zephyr runtime glue. The dependencies are
# gl_slint's (../../gl_slint/rust/Cargo.toml.in), plus libm for the drive
# cycle's expf.

[package]
name = "slint_cluster"
version = "0.0.0"
edition = "2021"
build = "@CARGO_SRC@/build.rs"

[lib]
path = "@CARGO_SRC@/src/lib.rs"
crate-type = ["staticlib"]

[dependencies]
# The cluster sample's check and records (../check, through src/board.rs).
cluster-check = { package = "yakogl-cluster-check", path = "@CARGO_SRC@/../check" }
slint = { path = "@SLINT_NOSTD_DIR@/api/rs/slint", default-features = false, features = ["compat-1-2", "unsafe-single-threaded", "libm"] }
i-slint-renderer-femtovg = { path = "@SLINT_NOSTD_DIR@/internal/renderers/femtovg", default-features = false, features = ["opengl"] }
i-slint-core = { path = "@SLINT_NOSTD_DIR@/internal/core", default-features = false, features = ["libm", "unsafe-single-threaded"] }
libm = "0.2"

[build-dependencies]
# renderer-software: EmbedForSoftwareRenderer pre-renders the fonts (bitmap
# glyphs) and decodes the images at compile time; the no_std target has
# neither a font stack nor an image decoder at run time.
slint-build = { path = "@SLINT_NOSTD_DIR@/api/rs/build", default-features = false, features = ["compat-1-18", "renderer-software"] }

[profile.release]
panic = "abort"
opt-level = "z"

[profile.dev]
panic = "abort"

# Own workspace root: do not attach to any Cargo workspace above the build dir.
[workspace]

# femtovg/glow from crates.io are not no_std: the no_std forks, as gl_slint.
[patch.crates-io]
femtovg = { path = "@NOSTD_PATCH_DIR@/femtovg" }
glow = { path = "@NOSTD_PATCH_DIR@/glow" }
