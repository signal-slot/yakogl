/*
 * The board's sram0 is 512 KiB at 0x200000 (dts/arm64/broadcom/bcm2711.dtsi).
 * This image carries the V3D's 48 MiB carve-out, the compiler's 2 MiB
 * scratch and the 1024x608 window (2.4 MiB) as statics, so it gets 96 MiB
 * from 0x200000 (v3d_gl_triangle's). DRAM starts at 0 on the Pi 4 and the
 * firmware keeps its own memory at the top of the first GiB (the framebuffer
 * is at 0x3c100000), so this is ARM memory on every Pi 4.
 */
#include "../../common/rpi_4b_sram.dtsi"

&sram0 {
	reg = <0x200000 0x6000000>;
};
