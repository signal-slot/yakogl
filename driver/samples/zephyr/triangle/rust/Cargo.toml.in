# SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
# Generated by CMake (configure_file); @VAR@ are substituted at configure time.
#
# The one triangle sample's staticlib (driver/samples/zephyr/triangle): the
# scene (vertices, clear colour, shader texts) and the check, both from the
# check crate (../check), behind the C entry points main.c calls. Configured
# into the build directory, as the slint sample's is, so no Cargo.lock lands
# in the source tree.

[package]
name = "triangle_sample"
version = "0.0.0"
edition = "2021"

[lib]
path = "@CARGO_SRC@/src/lib.rs"
crate-type = ["staticlib"]

[dependencies]
triangle-check = { package = "yakogl-triangle-check", path = "@TRIANGLE_CHECK_DIR@" }

[profile.release]
panic = "abort"
# the check classifies 614,400 pixels once per run
opt-level = 2

[profile.dev]
panic = "abort"

# Own workspace root: do not attach to any Cargo workspace above the build dir.
[workspace]
