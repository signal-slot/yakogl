/* The STM32MP257F-DK's A35: the board layer's GPU node (clock rate), as
 * gl_test, gc_fence and gc_clear take it, and a larger carve-out than the
 * board's. */
#include "../../../../zephyr/lib/board/stm32mp2/app.overlay"

/* A 240 MiB GPU carve-out instead of the board's 64 MiB gpu-reserved area at
 * 0xfa800000 (driver/boards/st/stm32mp257f_dk), as the Verdin iMX8M Plus'
 * glmark2 image takes (issue #814): every GC allocation of the scenes comes
 * from this one pool, frees are held until their kick completes, and one
 * scene's peak (terrain) is 51 MB on the host, more than 64 MiB holds with
 * the scenes running one after another. ST's area cannot grow: System RAM
 * ends at 0xfa7fffff, and U-Boot relocates just below that.
 *
 * Where: 0xb0000000, just above the image's 256 MiB (zephyr,sram at
 * 0xa0000000, the link address) and far below U-Boot, which relocates to the
 * top of usable RAM. It is System RAM in ST's Linux (0x84000000-0xfa7fffff),
 * not a reserved area, so unlike gpu-reserved it is not known to be open to
 * the GPU's bus master: the first run on the DK confirms it (gc_fence's
 * carve-out check). Below 4 GiB and 4 MiB aligned, as the GC's MMU needs
 * (mmu.rs); 240 MiB is 60 of the 64 slave tables the carve-out's head holds
 * (gc_internal.h GC_STLB_COUNT). */
/* The display chain: LTDC -> DSI -> ADV7535 -> HDMI, nodes and properties as
 * tools/probes/stm32mp257f_dk/mp2_display/boards/*.overlay has them (ST's
 * tree: stm32mp251.dtsi:935 and :2150, stm32mp255.dtsi:123,
 * stm32mp257f-dk.dts:328-350, :428-460, :536-547). The LTDC driver chooses
 * 1920x1080@60 when the EDID prefers it, else 1280x720@60; ARGB8888.
 *
 * ltdc_fb: 16 MiB no-map at 0xbf000000, directly above the GPU carve-out
 * (0xb0000000-0xbeffffff) and below 0xc0000000. mp2_display's own
 * 0xb0000000 would overlap that carve-out here. It is not in the image
 * either (0xa0000000 + 256 MiB = 0xb0000000) nor in ST's LTDC secure-layer
 * areas (0xfe800000). It is System RAM inside RISAF4 region 9
 * (0x84000000-0xfa7fffff, non-secure, CID0/1 r/w), below 4 GiB for the
 * LTDC's 32-bit CFBAR, and holds two 1080p XRGB8888 frames
 * (2 x 8294400 bytes < 16 MiB). */
/ {
	chosen {
		yakogl,ltdc-fb = &ltdc_fb;
	};

	reserved-memory {
		ltdc_fb: framebuffer@bf000000 {
			reg = <0xbf000000 DT_SIZE_M(16)>;
			no-map;
		};

		gpu_carveout_glmark2: gpu-carveout@b0000000 {
			reg = <0xb0000000 0x0f000000>;
			no-map;
		};
	};
};

&gpu {
	memory-region = <&gpu_carveout_glmark2>;
};

/* The chain's own nodes, as in mp2_display: the clocks are what the board
 * layer's power-on sets (display_power_mp2.c: ck_ker_i2c2 100 MHz, the DSI
 * PHY reference 27 MHz, the LTDC pixel clock the chosen mode's rate). The
 * bridge's INT/reset pins are the board layer's; no interrupts (polled). */
/ {
	soc {
		i2c2: i2c@40130000 {
			compatible = "yakogl,stm32mp2-i2c";
			reg = <0x40130000 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			clock-frequency = <400000>;
			kernel-clock-frequency = <100000000>;
			status = "okay";

			adv7535: hdmi@3d {
				compatible = "yakogl,adv7535";
				reg = <0x3d>;
				edid-reg = <0x3f>;
				cec-reg = <0x3c>;
				packet-reg = <0x38>;
				adi,dsi-lanes = <4>;
				status = "okay";
			};
		};

		dsi: dsi@48000000 {
			compatible = "yakogl,stm32-dsi";
			reg = <0x48000000 0x800>;
			data-lanes = <4>;
			bridge = <&adv7535>;
			pll-ref-frequency = <27000000>;
			/* the LTDC driver sets the chosen mode's */
			pixel-clock-frequency = <148500000>;
			status = "okay";
		};

		/* hactive x vactive: the largest mode the driver may choose;
		 * one 1080p XRGB8888 frame (pitch 7680) fits fb-size. */
		ltdc: display-controller@48010000 {
			compatible = "yakogl,stm32-ltdc";
			reg = <0x48010000 0x400>;
			hactive = <1920>;
			vactive = <1080>;
			pixel-format = "argb8888";
			fb-size = <0x800000>;
			dsi-host = <&dsi>;
			status = "okay";
		};
	};
};
