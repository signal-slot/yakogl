/*
 * Toradex Verdin AM62P (board definition). The board DTS has the GPU
 * node with its 64 MiB carveout and the display path wired but disabled
 * (the R5F owns the display in the platform). This stand-alone
 * application drives the panel itself, so it enables DSS1, DSI, the bridge
 * on I2C1, the GPIO banks and the TISCI power-on list.
 */

&tisci_power_on {
	status = "okay";
};

&main_gpio0_1 {
	status = "okay";
};

&main_gpio1_0 {
	status = "okay";
};

&main_i2c1 {
	status = "okay";
};

&panel {
	status = "okay";
};

&dss1 {
	status = "okay";
};

&dsi0 {
	status = "okay";
};

/* A 256 MiB GPU carve-out instead of the board's 64 MiB one, as the dEQP
 * image takes (driver/samples/zephyr/deqp/boards/, run from U-Boot on
 * 2026-10-12 with 0 resets). At 64 MiB about 36 MiB are taken whatever the
 * scene (firmware, parameter buffer, freelists, HWRT sets;
 * docs/notes/pvr-render-pool.md), so terrain's 5.6 MB
 * NPOT mip chain and shadow's 22 MB depth chain cannot fit and refract's
 * target allocations are refused (issues #1, #2). The board's 64 MiB region
 * stays reserved but unused. */
/ {
	reserved-memory {
		gpu_carveout_glmark2: gpu-carveout@a0000000 {
			reg = <0xa0000000 0x10000000>;
			no-map;
		};
	};
};

&gpu {
	memory-region = <&gpu_carveout_glmark2>;
};
