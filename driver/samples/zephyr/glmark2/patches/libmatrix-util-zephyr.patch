+namespace {
+
+/* An input stream over a linked-in file, read in place (no copy). It seeks
+ * like the std::ifstream it replaces (model.cpp skips 3DS chunks with seekg). */
+class AssetBuf : public std::streambuf
+{
+public:
+    AssetBuf(const char *data, size_t size)
+    {
+        char *p = const_cast<char *>(data);
+        setg(p, p, p + size);
+    }
+
+protected:
+    pos_type seekoff(off_type off, std::ios_base::seekdir dir,
+                     std::ios_base::openmode which) override
+    {
+        if (!(which & std::ios_base::in))
+            return pos_type(off_type(-1));
+        off_type base = 0;
+        if (dir == std::ios_base::cur)
+            base = gptr() - eback();
+        else if (dir == std::ios_base::end)
+            base = egptr() - eback();
+        return seekpos(pos_type(base + off), which);
+    }
+
+    pos_type seekpos(pos_type pos, std::ios_base::openmode which) override
+    {
+        off_type p = off_type(pos);
+        if (!(which & std::ios_base::in) || p < 0 || p > egptr() - eback())
+            return pos_type(off_type(-1));
+        setg(eback(), eback() + p, egptr());
+        return pos;
+    }
+};
+
+class AssetStream : private AssetBuf, public std::istream
+{
+public:
+    AssetStream(const char *data, size_t size)
+        : AssetBuf(data, size), std::istream(static_cast<std::streambuf *>(this))
+    {
+    }
+};
+
+}
+
+std::istream *
+Util::get_resource(const std::filesystem::path &path)
+{
+    const void *data = nullptr;
+    size_t size = 0;
+
+    if (glmark2_asset_find(path.string().c_str(), &data, &size) != 0) {
+        /* As a std::ifstream on a missing file: a stream in the fail state,
+         * which every caller checks. */
+        Log::error("No linked-in file %s\n", path.string().c_str());
+        std::istream *is = new AssetStream(nullptr, 0);
+        is->setstate(std::ios::failbit);
+        return is;
+    }
+    return new AssetStream(static_cast<const char *>(data), size);
+}
+
+void
+Util::list_files(const std::filesystem::path& dirName,
+                 std::vector<std::filesystem::path>& fileVec)
+{
+    /* "/glmark2/models/" names the same directory as "/glmark2/models", as
+     * for std::filesystem::directory_iterator */
+    std::filesystem::path dir = dirName.lexically_normal();
+    if (!dir.has_filename())
+        dir = dir.parent_path();
+
+    for (size_t i = 0; i < glmark2_asset_count(); i++) {
+        const std::filesystem::path p(glmark2_asset_name(i));
+        if (p.parent_path().lexically_normal() == dir)
+            fileVec.push_back(p);
+    }
+}
