# Generated by CMake (configure_file); @VAR@ are substituted at configure time.
# FVG_NOSTD_DIR points at Agent A's no_std workspace (fvg_demo + patched
# femtovg/glow); it lives outside the repo (a scratchpad checkout), so the
# path is injected rather than committed.

[package]
name = "fvg_zephyr"
version = "0.0.0"
edition = "2021"

[lib]
path = "@CARGO_SRC@/src/lib.rs"
crate-type = ["staticlib"]

[dependencies]
fvg_demo = { path = "@FVG_NOSTD_DIR@/fvg_demo", features = ["external_rt"] }

[profile.release]
panic = "abort"
opt-level = "z"

[profile.dev]
panic = "abort"

# Own workspace root: do not attach to any Cargo workspace above the build dir.
[workspace]
