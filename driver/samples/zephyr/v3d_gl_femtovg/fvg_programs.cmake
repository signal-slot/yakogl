# femtovg's 30 programs through GL (src/fvg_programs.h), for a sample whose
# frame is drawn by the no_std femtovg: v3d_gl_femtovg (v3d_gl_cluster used it
# too, until Step 5 deleted it). include() this after project().
#
#   v3d_fvg_programs(<femtovg tree>)
#
# embeds that tree's src/renderer/opengl/main-vs.glsl and main-fs.glsl as C
# strings (gen/fvg_glsl.h: fvg_main_vs, fvg_main_fs) and adds
# src/fvg_programs.c to the app. The tree is the one the sample's Rust
# archive builds femtovg from, so the programs are the ones it will build.
set(V3D_FVG_PROGRAMS_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(v3d_fvg_programs femtovg_dir)
  set(glsl_dir "${femtovg_dir}/src/renderer/opengl")
  set(out "${CMAKE_CURRENT_BINARY_DIR}/gen/fvg_glsl.h")
  set(body "/* generated by v3d_gl_femtovg/fvg_programs.cmake from ${glsl_dir} */\n")
  foreach(pair "main-vs.glsl;fvg_main_vs" "main-fs.glsl;fvg_main_fs")
    list(GET pair 0 file)
    list(GET pair 1 sym)
    if(NOT EXISTS "${glsl_dir}/${file}")
      message(FATAL_ERROR "v3d_fvg_programs: ${glsl_dir}/${file} is missing")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${glsl_dir}/${file}")
    file(READ "${glsl_dir}/${file}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND body "static const char ${sym}[] = { ${bytes} 0 };\n")
  endforeach()
  file(WRITE "${out}.tmp" "${body}")
  configure_file("${out}.tmp" "${out}" COPYONLY)
  target_include_directories(app PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/gen"
                                         "${V3D_FVG_PROGRAMS_DIR}/src")
  target_sources(app PRIVATE "${V3D_FVG_PROGRAMS_DIR}/src/fvg_programs.c")
endfunction()
