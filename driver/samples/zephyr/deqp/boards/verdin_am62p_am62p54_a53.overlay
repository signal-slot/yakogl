/*
 * Toradex Verdin AM62P (SafeUI board definition). The board DTS has the GPU
 * node with its 64 MiB carveout and the display path wired but disabled
 * (the R5F owns the display in the SafeUI platform). This stand-alone
 * application drives the panel itself, so it enables DSS1, DSI, the bridge
 * on I2C1, the GPIO banks and the TISCI power-on list.
 */

/* A 256 MiB GPU carveout instead of the board's 64 MiB one, as the Qt
 * firmware takes: dEQP's texture.size group uploads 2048x2048 textures with
 * their mip chains, and with 64 MiB the 2048x2048 L8 upload returned
 * GL_OUT_OF_MEMORY, which dEQP treats as a ResourceError that ABORTS the run
 * (AM62P, 2026-09-24: texture.* stopped after 445 cases). Linux reserves
 * nothing from 0xa0000000 up and the image is kexec'ed, so that DDR is ours;
 * the board's 64 MiB region stays reserved but unused. */
/ {
	reserved-memory {
		gpu_carveout_deqp: gpu-carveout@a0000000 {
			reg = <0xa0000000 0x10000000>;
			no-map;
		};
	};
};

&gpu {
	memory-region = <&gpu_carveout_deqp>;
};

&tisci_power_on {
	status = "okay";
};

&main_gpio0_1 {
	status = "okay";
};

&main_gpio1_0 {
	status = "okay";
};

&main_i2c1 {
	status = "okay";
};

&panel {
	status = "okay";
};

&dss1 {
	status = "okay";
};

&dsi0 {
	status = "okay";
};
