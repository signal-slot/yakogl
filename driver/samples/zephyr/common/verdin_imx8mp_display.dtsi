/*
 * SPDX-License-Identifier: Apache-2.0
 * SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
 *
 * The display chain of a Verdin iMX8M Plus on a Mallow carrier with the
 * 10.1-inch Riverdi RVT101HVDWC00-B panel, as the Zephyr device tree needs
 * it. Included by the samples' Verdin iMX8M Plus board overlays.
 *
 * Every address, GPIO, I2C address and timing here was read out of the
 * board's own live Linux device tree (2026-09-20), not out of a datasheet:
 *   lcd-controller@32e80000  "fsl,imx8mp-lcdif1"     (LCDIFv3, "LCDIF1")
 *   mipi_dsi@32e60000        "fsl,imx8mp-mipi-dsim"
 *   blk-ctrl@32ec0000        "fsl,imx8mp-media-blk-ctrl" (ours:
 *                            yakogl,imx8mp-media-blk-ctrl, with the GPC,
 *                            CCM and CCM_ANALOG ranges)
 *   pwm@30680000             PWM3, backlight-verdin-dsi, 6667179 ns period
 *   i2c@30a30000/bridge@2c   "ti,sn65dsi83", enable-gpios GPIO4 28 active high
 *   panel-rvt101hvdwc00b     panel-lvds, data-mapping "vesa-24"
 *
 * Note the numbering: Linux's i2c@30a30000 is I2C2, which is Zephyr's
 * &i2c2 as well, and its pinctrl group uses the dedicated I2C2_SCL/SDA
 * pads. The bridge is an SN65DSI84 on the schematic but Linux drives it as
 * an SN65DSI83, i.e. one LVDS link; src/display/NOTES.md has the detail.
 *
 * This belongs in boards/toradex/verdin_imx8mp/ in the SafeUI application
 * repository once it has run on hardware. It lives here while it is
 * unproven so that repository keeps building for everyone else.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

&pinctrl {
	/*
	 * Pad settings approximate what Linux writes: I2C2 gets 0x400001c6
	 * (max drive, pull-up, hysteresis, and the SION bit that an I2C pad
	 * needs so the controller can read the line back), PWM3 gets 0x06.
	 * See NOTES.md, "Open questions".
	 */
	i2c2_display: i2c2_display {
		group0 {
			pinmux = <&iomuxc_i2c2_scl_i2c_scl_i2c2_scl>,
				 <&iomuxc_i2c2_sda_i2c_sda_i2c2_sda>;
			drive-strength = "x6";
			slew-rate = "slow";
			bias-pull-up;
			drive-open-drain;
			input-schmitt-enable;
			input-enable;
		};
	};

	pwm3_backlight: pwm3_backlight {
		group0 {
			/* PWM_3_DSI on the Verdin is the SAI5_RXC pad (Linux pwm3grp:
			 * mux 0x130 ALT2), not GPIO1_IO14, which also carries PWM3. */
			pinmux = <&iomuxc_sai5_rxc_pwm_out_pwm3_out>;
			drive-strength = "x4";
			slew-rate = "slow";
		};
	};
};

/* The bridge EN line is GPIO4_IO28 (Verdin GPIO_10_DSI). The gpio driver
 * muxes the pad itself, from the pinmux list in the SoC dtsi. */
&gpio4 {
	status = "okay";
};

&i2c2 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c2_display>;
	pinctrl-names = "default";

	/* Driven by display0 (no dsi-host): its EN is claimed at the level
	 * the chain is found at, and nothing is written on the adopt path.
	 * LVDS side as the board's Linux runs it (golden dump 0x18 = 0x18):
	 * single link, 24 bpp, format 2, HS/VS/DE positive -- the panel is
	 * DE-driven, its stated HS/VS polarity is not what the bridge drives
	 * (src/display/NOTES.md). Termination 200 ohm, the reset value
	 * (0x1A = 0x03). */
	lvds_bridge: bridge@2c {
		compatible = "yakogl,sn65dsi8x";
		reg = <0x2c>;
		enable-gpios = <&gpio4 28 GPIO_ACTIVE_HIGH>;
		data-lanes = <4>;
		lvds-24bpp;
		status = "okay";
	};
};

/ {
	soc {
		/* PWM3 (PWM_3_DSI), the backlight. Its clock root and gate are
		 * hal_nxp fsl_clock.h's kCLOCK_RootPwm3 = ROOT[105] and
		 * kCLOCK_Pwm3 = CCM_TUPLE(42, 105). */
		backlight_pwm: pwm@30680000 {
			compatible = "yakogl,imx-pwm";
			reg = <0x30680000 0x10000>,
			      <0x30380000 0x10000>;
			reg-names = "pwm", "ccm";
			ccm-root = <105>;
			ccm-gate = <42>;
			#pwm-cells = <3>;
			pinctrl-0 = <&pwm3_backlight>;
			pinctrl-names = "default";
			status = "okay";
		};

		/* MEDIAMIX and its display domains (yakogl,imx8mp-media-pd),
		 * and the clocks a kexec'd image must open before any driver:
		 * I2C2_CLK_ROOT (91) and PWM3_CLK_ROOT (105), gates I2C2 (24),
		 * PWM3 (42) and GPIO4 (14) -- IMX8MPRM Tables 5-1 and 5-9. */
		media_blk_ctrl: blk-ctrl@32ec0000 {
			compatible = "yakogl,imx8mp-media-blk-ctrl";
			reg = <0x32ec0000 0x10000>,   /* MEDIA_BLK_CTRL */
			      <0x303a0000 0x10000>,   /* GPC */
			      <0x30380000 0x10000>,   /* CCM */
			      <0x30360000 0x10000>;   /* CCM_ANALOG */
			reg-names = "blkctrl", "gpc", "ccm", "anatop";
			early-ccm-roots = <91 105>;
			early-ccm-gates = <24 42 14>;
			status = "okay";

			pd_lcdif1: pd-lcdif1 {
				compatible = "yakogl,imx8mp-media-pd";
				domain = "lcdif1";
				#power-domain-cells = <0>;
			};

			pd_mipi_dsi1: pd-mipi-dsi1 {
				compatible = "yakogl,imx8mp-media-pd";
				domain = "mipi-dsi1";
				#power-domain-cells = <0>;
			};
		};

		/* LCDIF1 and the MIPI DSI host as devices of their own, register
		 * logic in Rust (driver/docs/imx8mp-display-cold.md). display0
		 * drives them only with CONFIG_YAKOGL_DRV_DISPLAY_IMX8MP_LCDIF_RUST /
		 * CONFIG_YAKOGL_DRV_DSIM_RUST (default n: src/display/imx8mp_lcdif.c
		 * and imx8mp_dsim.c on display0's own reg ranges). INV_PXCK as the
		 * board's Linux has it (CTRL 0x08); panic thresholds 1/3 and 2/3
		 * of the FIFO as NXP's SDK suggests; LCDIF1 is Arm interrupt 5
		 * (IMX8MPRM Table 7-1). The DSIM's clock facts repeat display0's
		 * (the build checks they agree). */
		lcdif1: display-controller@32e80000 {
			compatible = "yakogl,imx8mp-lcdif";
			reg = <0x32e80000 0x10000>;
			interrupts = <GIC_SPI 5 IRQ_TYPE_LEVEL IRQ_DEFAULT_PRIORITY>;
			interrupt-parent = <&gic>;
			hactive = <1280>;
			vactive = <800>;
			pixclk-rising;
			panic-thresholds = <170 340>;
			dsi-host = <&mipi_dsi>;
			status = "okay";
		};

		mipi_dsi: dsi@32e60000 {
			compatible = "yakogl,samsung-dsim";
			reg = <0x32e60000 0x1000>;
			pll-ref-frequency = <12000000>;
			burst-clock-frequency = <426600000>;
			esc-clock-frequency = <20000000>;
			data-lanes = <4>;
			pixel-clock-frequency = <69300000>;
			burst-mode;
			status = "okay";
		};

		display0: display@32e80000 {
			compatible = "yakogl,imx8mp-display";
			reg = <0x32e80000 0x10000>,   /* LCDIFv3 ("LCDIF1") */
			      <0x32e60000 0x1000>;    /* MIPI DSIM + D-PHY */
			reg-names = "lcdif", "dsim";
			power-domains = <&pd_lcdif1>, <&pd_mipi_dsi1>;

			bridge = <&lvds_bridge>;
			lcdif = <&lcdif1>;
			dsi = <&mipi_dsi>;
			dsi-lanes = <4>;

			/* Riverdi RVT101HVDWC00-B (min 66.3 MHz, typ 71.1 MHz,
			 * max 78.9 MHz) at the board's Linux plan: VIDEO_PLL1
			 * 1039.5 MHz (m 173, k 16384) / 15 = 69.3 MHz, 69.3e6 /
			 * (1404 x 840) = 58.76 Hz. DSIM reference 24 MHz / 2, DSI
			 * burst clock 426.6 MHz (PLL p 5 m 711 s 2).
			 *
			 * The rule: the lane rate must exceed pixel x 24 / lanes
			 * by a margin, for the packet overhead of every line (the
			 * headers and checksums of the blanking and pixel packets,
			 * the HS entry and exit). 69.3 MHz leaves 426.6 / 415.8 =
			 * 2.6 %, and is the plan the panel was seen right at
			 * (2026-09-24). A clock with no margin breaks the picture:
			 * 71.43 MHz on a 428.6 Mbit/s link (2026-09-23) and 71.1
			 * MHz on 426.6 Mbit/s (71.1 x 24 / 4 exactly; the panel
			 * showed 1.5 copies of the frame a line, 2026-10-06,
			 * issue #23). ip::samsung_dsim::LINK_MARGIN_PERMILLE pins
			 * the margin; dsi_chain_tests.rs (verdin_dt) reads this
			 * node and refuses a plan without it, and imx8mp_display.c
			 * has the same check as a BUILD_ASSERT.
			 *
			 * The DSIM's HBP word count is 43 at 69.3 MHz (64 x
			 * 53.325 / 69.3 - 6), Linux's 42 being computed for its
			 * 71.1 MHz mode; 43 is what ran on 2026-09-24. The bridge
			 * CSRs do not depend on the pixel clock: DSI clock 213.3 MHz
			 * (CHA_DSI_CLK_RANGE 42), divider 3, LVDS clock 71.1 MHz,
			 * as Linux has them (0x0b = 0x10, 0x12 = 0x2a). NOTES.md,
			 * "Pixel clock". */
			clock-frequency = <69300000>;
			video-pll1-frequency = <1039500000>;
			pll-ref-frequency = <12000000>;
			burst-clock-frequency = <426600000>;
			hactive = <1280>;
			vactive = <800>;
			hfront-porch = <36>;
			hback-porch = <64>;
			hsync-len = <24>;
			vfront-porch = <8>;
			vback-porch = <24>;
			vsync-len = <8>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;

			pwms = <&backlight_pwm 0 6667179 PWM_POLARITY_NORMAL>;
			backlight-brightness-percent = <100>;

			status = "okay";
		};
	};
};
