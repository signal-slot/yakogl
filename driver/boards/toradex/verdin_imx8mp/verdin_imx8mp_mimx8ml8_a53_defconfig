CONFIG_XIP=n
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CLOCK_CONTROL=y

# ARM Options
CONFIG_AARCH64_IMAGE_HEADER=y
CONFIG_ARMV8_A_NS=y
CONFIG_ARM64_VA_BITS_36=y
CONFIG_ARM64_PA_BITS_36=y

# Cache Options
CONFIG_CACHE_MANAGEMENT=y
CONFIG_DCACHE_LINE_SIZE_DETECT=y
CONFIG_ICACHE_LINE_SIZE_DETECT=y

# Multicore
CONFIG_SMP=y
CONFIG_PM_CPU_OPS=y
CONFIG_MP_MAX_NUM_CPUS=4

# This image is booted with kexec out of Linux and is then the only OS on
# the cluster. Zephyr's i.MX8MP A53 SoC config defaults GIC_SAFE_CONFIG=y
# (several OSes sharing the GIC), which skips the distributor init when
# the distributor is found enabled, and Linux leaves it enabled: every SPI
# Linux had enabled, routed and prioritised stayed that way and fired into
# Zephyr (measured 2026-09-20: stray interrupts at random times, and a
# fatal error when the third CPU came up with the GPIO or I2C driver in
# the image). Re-initialise the distributor.
CONFIG_GIC_SAFE_CONFIG=n
