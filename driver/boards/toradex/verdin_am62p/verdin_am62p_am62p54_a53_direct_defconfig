# The a53 image type, started by the A53 U-Boot SPL in place of U-Boot proper
# (docs/notes/am62p-direct-boot.md). The SPL enters it at its FIT load address in
# non-secure EL2 (TF-A gives BL33, the SPL, EL2; the SPL stays there) with the
# MMU and data cache off (spl_board_prepare_for_boot); the arm64 reset path
# drops to EL1. The image header's first word is "b __start", so entering at
# the load address is entering at the code.
CONFIG_XIP=n
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# ARM Options
CONFIG_AARCH64_IMAGE_HEADER=y
CONFIG_ARMV8_A_NS=y
CONFIG_ARM64_VA_BITS_36=y
CONFIG_ARM64_PA_BITS_36=y

# Cache Options
CONFIG_CACHE_MANAGEMENT=y
CONFIG_DCACHE_LINE_SIZE_DETECT=y
CONFIG_ICACHE_LINE_SIZE_DETECT=y

# Multicore: the secondary cores are off until PSCI CPU_ON, which TF-A serves.
CONFIG_SMP=y
CONFIG_PM_CPU_OPS=y
CONFIG_MP_MAX_NUM_CPUS=4
