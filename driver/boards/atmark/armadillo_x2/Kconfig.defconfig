if BOARD_ARMADILLO_X2

# The panel console (yakogl_gc_board) draws into the LCDIF that is scanning:
# on this board that is LCDIF3, which feeds HDMI. Reading LCDIF1's default
# address instead would touch a block whose power domain may be off.
config GC_COMMON_PANEL_CONSOLE_LCDIF_BASE
	default 0x32fc6000

# This board's U-Boot (2020.04-at30) keeps its boot count in LPGPR0
# (0xdead0000 | count, read back on 2026-10-01) and leaves LPGPR1..3 alone
# across a reset (a PROGRESS record survived three boots), so the result
# record moves one register up and stops at its third word. Its Linux has no
# snvs-lpgpr nvmem device: driver/tools/kexec-zephyr/snvs_lpgpr reads (and
# writes the selector) through /dev/mem. UART2 is the console when it is
# wired to a host.
config GC_COMMON_RESULT_SNVS_KEEP_LPGPR0
	default y

endif # BOARD_ARMADILLO_X2
