#
# The compiled-in default environment of "build-uboot.sh redund"
# (mp2-standalone-redund.config, CONFIG_DEFAULT_ENV_FILE), what U-Boot runs on
# when both stored copies are bad. The addresses are qemu-arm.env's. bootcmd
# runs env_check before the scan, as ST's bootcmd_stm32mp does
# (stm32mp25_st_common.h:31), with ST's env_check text
# (stm32mp25_common.h:94). boot_targets is the microSD only, as the other
# cases preset it.
fdt_high=0xffffffff
initrd_high=0xffffffff
fdt_addr=0x40000000
scriptaddr=0x40200000
pxefile_addr_r=0x40300000
kernel_addr_r=0x40400000
ramdisk_addr_r=0x44000000
boot_targets=mmc0
env_check=if env info -p -d -q; then env save; fi
bootcmd=run env_check; bootflow scan -lb
