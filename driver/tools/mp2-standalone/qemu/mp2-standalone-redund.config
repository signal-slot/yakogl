#
# Kconfig fragment layered on mp2-standalone.config by "build-uboot.sh redund",
# for the env_* cases (README.md in this directory): the environment as the DK
# keeps it instead of in CFI flash.
#
# The DK: CONFIG_ENV_IS_IN_MMC on the card that booted, two copies
# (CONFIG_SYS_REDUNDAND_ENVIRONMENT=y, ST's stm32mp25_defconfig:72) at the top
# of the 512 KiB u-boot-env partition, the first at 0x7e000 in it
# (pre-study-stm32mp257f-dk.md, "U-Boot's flow"), so 8 KiB each, the second
# below it (env/mmc.c, mmc_offset_try_partition). Here: mkdisk.sh's "env"
# partition 3, u-boot-env, at sector 61440 (0x1e00000), 512 KiB; the copies at
# 0x1e00000 + 0x7e000 and + 0x7c000 of the disk. QEMU's device tree has no
# u-boot,mmc-env-partition, so the offsets are absolute (the same bytes).
CONFIG_ENV_IS_IN_FLASH=n
CONFIG_ENV_IS_IN_MMC=y
CONFIG_SYS_REDUNDAND_ENVIRONMENT=y
CONFIG_SYS_MMC_ENV_DEV=0
CONFIG_ENV_SIZE=0x2000
CONFIG_ENV_OFFSET=0x1e7e000
CONFIG_ENV_OFFSET_REDUND=0x1e7c000
# env_check's "env info -p -d -q" (ST's stm32mp25_common.h:94).
CONFIG_CMD_NVEDIT_INFO=y
# The default environment: redund-default.env (qemu-arm.env's addresses,
# boot_targets mmc0, ST's env_check run by bootcmd before the scan).
# build-uboot.sh puts this directory's absolute path in for @HERE@.
CONFIG_USE_DEFAULT_ENV_FILE=y
CONFIG_DEFAULT_ENV_FILE="@HERE@/redund-default.env"
