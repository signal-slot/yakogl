#
# Kconfig fragment on top of U-Boot v2023.10 qemu_arm64_defconfig, for
# build-uboot.sh (README.md in this directory).
#
# The environment: qemu_arm64_defconfig keeps it in CFI flash at 0x04000000
# (ENV_IS_IN_FLASH, QEMU virt's second pflash, -drive if=pflash,unit=1), so a
# saveenv survives a QEMU restart on the same image file.
CONFIG_ENV_IS_IN_FLASH=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_ITEST=y
CONFIG_CMD_SOURCE=y
CONFIG_CMD_GO=y
CONFIG_CMD_CACHE=y
CONFIG_CMD_PART=y
# The distro boot: standard boot's bootflow scan over mmc, reaching
# boot.scr.uimg (and extlinux) in the bootfs partition. bootcmd stays the
# defconfig's own ("bootflow scan -lb").
CONFIG_BOOTSTD_FULL=y
CONFIG_BOOTSTD_DEFAULTS=y
CONFIG_CMD_BOOTFLOW=y
CONFIG_BOOTMETH_SCRIPT=y
CONFIG_BOOTMETH_EXTLINUX=y
# The DK's microSD: MMC on PCI (sdhci-pci + sd-card), ext4 bootfs.
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_PCI=y
CONFIG_CMD_MMC=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_BOOTDELAY=1
# No GnuTLS on the build host needed.
CONFIG_TOOLS_MKEFICAPSULE=n
