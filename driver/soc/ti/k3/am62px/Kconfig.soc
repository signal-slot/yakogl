#
# TI AM62Px (AM62P54): 4x Cortex-A53, MCU Cortex-R5F, IMG BXS GPU, DSS0/DSS1.
# The AM62P main/MCU domains are the same silicon generation as J722S, so the
# MCU R5F devicetree reuses Zephyr's j722s_mcu_r5.dtsi.

config SOC_SERIES_AM62PX
	bool
	select SOC_FAMILY_TI_K3

config SOC_SERIES_AM62PX_A53
	bool
	select SOC_SERIES_AM62PX

config SOC_SERIES_AM62PX_R5
	bool
	select SOC_SERIES_AM62PX

config SOC_AM62P54_A53
	bool
	select SOC_SERIES_AM62PX_A53

config SOC_AM62P54_MCU_R5F0_0
	bool
	select SOC_SERIES_AM62PX_R5

config SOC_SERIES
	default "am62px" if SOC_SERIES_AM62PX

config SOC
	default "am62p54" if SOC_AM62P54_A53 || SOC_AM62P54_MCU_R5F0_0
