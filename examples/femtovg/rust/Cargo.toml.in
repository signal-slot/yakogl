# Generated by CMake (configure_file); @VAR@ are substituted at configure time.
#
# The femtovg example's staticlib (examples/femtovg): the scene drawn with
# femtovg over glow through YakoGL, and the check (../check). The no_std
# femtovg and glow forks (NOSTD_PATCH_DIR) are recreated from
# ../../nostd's patches, outside the repository; the path is injected, not
# committed.

[package]
name = "femtovg_example"
version = "0.0.0"
edition = "2021"

[lib]
path = "@CARGO_SRC@/src/lib.rs"
crate-type = ["staticlib"]

[dependencies]
femtovg-check = { package = "yakogl-femtovg-check", path = "@FEMTOVG_CHECK_DIR@", features = ["printk"] }
# No text: none of femtovg's text features (Slint's renderer takes the same).
femtovg = { path = "@NOSTD_PATCH_DIR@/femtovg", default-features = false }
glow = { path = "@NOSTD_PATCH_DIR@/glow", default-features = false }

[profile.release]
panic = "abort"
opt-level = "z"

[profile.dev]
panic = "abort"

# Own workspace root: do not attach to any Cargo workspace above the build dir.
[workspace]
