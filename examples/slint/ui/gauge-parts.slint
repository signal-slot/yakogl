//
// Building blocks of the meter cluster, drawn as vector geometry: arcs, tick
// rings, scale numbers, the framed bars and the pictograms of the safety
// layer. Each component mirrors one drawing routine of the C implementation
// of the cluster.
//
// Angles are degrees clockwise from 12 o'clock; a point at angle a and radius
// r sits at (cx + r*sin(a), cy - r*cos(a)) because y grows downwards.
//
// Sizes come from `Layout` (generated from
// include/cluster/ui_layout.h by its scripts/gen_layout_slint.py), so the
// same file draws the 1024x600 AM62P panel and the 1280x800 Verdin panel. The
// pictograms are the exception: they are line art with no name of their own in
// the shared header, so they keep the literals of the 1024x600 design and
// multiply them by `Layout.u`, one design pixel on this panel. That scale is
// the same in both axes on purpose -- a round lamp drawn with two scales is an
// ellipse.
//
// The container components inherit Rectangle (transparent) so that they span
// their parent and the absolute coordinates of their children are window
// coordinates; an element without a size would be centred in the parent.

import { Layout } from "cluster-layout.slint";
import { Theme } from "theme.slint";

// A stroked circular arc from angle a0 to a1 (yakogl_drv_arc). The Path element is
// a square centred on the dial centre, so a gradient brush given as the stroke
// has its centre on the dial centre too.
export component ArcStroke inherits Path {
    in property <length> cx;
    in property <length> cy;
    in property <length> radius;
    in property <float> a0;
    in property <float> a1;
    in property <length> thickness;
    in property <brush> stroke-brush;

    property <length> extent: root.radius + root.thickness;
    property <float> r: root.radius / 1px;

    x: root.cx - root.extent;
    y: root.cy - root.extent;
    width: 2 * root.extent;
    height: 2 * root.extent;
    viewbox-x: -root.extent / 1px;
    viewbox-y: -root.extent / 1px;
    viewbox-width: 2 * root.extent / 1px;
    viewbox-height: 2 * root.extent / 1px;
    stroke: root.stroke-brush;
    stroke-width: root.thickness;

    MoveTo {
        x: root.r * Math.sin(root.a0 * 1deg);
        y: -root.r * Math.cos(root.a0 * 1deg);
    }
    ArcTo {
        x: root.r * Math.sin(root.a1 * 1deg);
        y: -root.r * Math.cos(root.a1 * 1deg);
        radius-x: root.r;
        radius-y: root.r;
        large-arc: root.a1 - root.a0 > 180;
        sweep: true;
    }
}

// The graduations of a dial (tick_ring): `count` radial lines from radius
// tick-r0 outwards, every `major-every`-th one longer, wider and brighter, and
// every tick from index `red-from` on in the red-line colour.
export component TickRing inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <int> count;
    in property <int> major-every;
    in property <int> red-from: 9999;

    for i in root.count: Rectangle {
        property <bool> major: Math.mod(i, root.major-every) == 0;
        property <float> a: Layout.dial-a0 + Layout.dial-sweep * i / (root.count - 1);
        property <length> len: self.major ? Layout.tick-major-len : Layout.tick-minor-len;
        width: self.major ? 2.2 * Layout.u : 1.3 * Layout.u;
        height: self.len;
        x: root.cx - self.width / 2;
        y: root.cy - Layout.tick-r0 - self.len;
        background: i >= root.red-from ? Theme.tick-red : (self.major ? Theme.tick-major : Theme.tick-minor);
        transform-rotation: self.a * 1deg;
        transform-origin: { x: self.width / 2, y: Layout.tick-r0 + self.len };
    }
}

// The scale numbers of a dial (scale_numbers): `count` values of `step`,
// centred on the circle of radius num-r.
export component ScaleNumbers inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <int> count;
    in property <int> step;
    in property <length> font-size;
    in property <int> font-weight;

    property <length> box-w: 60 * Layout.u;
    property <length> box-h: 30 * Layout.u;

    for i in root.count: Text {
        property <float> a: Layout.dial-a0 + Layout.dial-sweep * i / (root.count - 1);
        text: i * root.step;
        color: Layout.text2;
        font-family: Theme.font;
        font-size: root.font-size;
        font-weight: root.font-weight;
        width: root.box-w;
        height: root.box-h;
        x: root.cx + Layout.num-r * Math.sin(self.a * 1deg) - root.box-w / 2;
        y: root.cy - Layout.num-r * Math.cos(self.a * 1deg) - root.box-h / 2;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// The dial band (dial): the dark track over the whole sweep, the live arc
// from the start to the value angle with its colour running from `tail` to
// `head` along the arc, and the bloom, a 20 degree wide fade-in ending at the
// value angle.
export component DialBand inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <float> frac;
    in property <color> tail;
    in property <color> head;

    property <float> f: Math.clamp(root.frac, 0, 1);
    property <float> a1: Layout.dial-a0 + Layout.dial-sweep * self.f;
    property <float> end: Layout.dial-a0 + Layout.dial-sweep;
    property <bool> lit: self.a1 > Layout.dial-a0 + 0.5;
    // gradient angles (a parenthesised expression right after `from` or a colour
    // would parse as a call, so they live in properties)
    property <angle> live-from: Layout.dial-a0 * 1deg;
    property <angle> live-span: (self.a1 - Layout.dial-a0) * 1deg;
    property <angle> bloom-from: (self.a1 - 20) * 1deg;

    ArcStroke {
        cx: root.cx; cy: root.cy; radius: Layout.dial-r; thickness: Layout.dial-w;
        a0: Layout.dial-a0; a1: root.end;
        stroke-brush: Layout.track;
    }
    if root.lit: ArcStroke {
        cx: root.cx; cy: root.cy; radius: Layout.dial-r; thickness: Layout.dial-w;
        a0: Layout.dial-a0; a1: root.a1;
        stroke-brush: @conic-gradient(from root.live-from, root.tail 0deg, root.head root.live-span);
    }
    if root.lit: ArcStroke {
        cx: root.cx; cy: root.cy; radius: Layout.dial-r; thickness: 20 * Layout.u;
        a0: Math.max(root.a1 - 20, Layout.dial-a0); a1: root.a1;
        stroke-brush: @conic-gradient(from root.bloom-from, Theme.bloom-clear 0deg, Theme.bloom 20deg);
    }
}

// The frame around a bar (frame_box): a faint rounded outline and the dark
// inset that the bar is drawn into.
export component FrameBox inherits Rectangle {
    in property <length> bx;
    in property <length> by;
    in property <length> bw;
    in property <length> bh;

    Rectangle {
        x: root.bx - 5 * Layout.u; y: root.by - 5 * Layout.u;
        width: root.bw + 10 * Layout.u; height: root.bh + 10 * Layout.u;
        border-radius: 7 * Layout.u; background: Theme.frame-ring;
    }
    Rectangle {
        x: root.bx - 3 * Layout.u; y: root.by - 3 * Layout.u;
        width: root.bw + 6 * Layout.u; height: root.bh + 6 * Layout.u;
        border-radius: 5 * Layout.u; background: Layout.bg-bottom;
    }
}

// The fuel pump beside the fuel bar (pump_icon): body with a window, base and
// the hose.
export component PumpIcon inherits Rectangle {
    in property <length> px;
    in property <length> py;
    in property <color> colour;

    Rectangle { x: root.px + 3 * Layout.u; y: root.py; width: 15 * Layout.u; height: 24 * Layout.u; border-radius: 3 * Layout.u; background: root.colour; }
    Rectangle { x: root.px + 6 * Layout.u; y: root.py + 4 * Layout.u; width: 9 * Layout.u; height: 7 * Layout.u; background: Layout.bg-bottom; }
    Rectangle { x: root.px; y: root.py + 24 * Layout.u; width: 21 * Layout.u; height: 3 * Layout.u; border-radius: 1 * Layout.u; background: root.colour; }
    Rectangle { x: root.px + 20 * Layout.u; y: root.py + 5 * Layout.u; width: 3 * Layout.u; height: 15 * Layout.u; border-radius: 1 * Layout.u; background: root.colour; }
    Rectangle { x: root.px + 20 * Layout.u; y: root.py + 18 * Layout.u; width: 7 * Layout.u; height: 3 * Layout.u; border-radius: 1 * Layout.u; background: root.colour; }
    Rectangle { x: root.px + 24 * Layout.u; y: root.py + 10 * Layout.u; width: 3 * Layout.u; height: 10 * Layout.u; border-radius: 1 * Layout.u; background: root.colour; }
}

// --- telltale pictograms of the safety layer -----------------------------
// Each takes the x of its slot (Layout.tt-slot-w wide); the row is at
// Layout.tt-y, Layout.tt-h high. The art itself is the 1024x600 design's,
// scaled isotropically by Layout.u.

// Turn indicator (turn_arrow): a 16 px triangle and a stem, pointing left,
// or right when mirrored.
export component TurnArrow inherits Rectangle {
    in property <length> slot-x;
    in property <bool> right;
    in property <color> colour;

    property <length> cy: Layout.tt-y + Layout.tt-h / 2;
    property <length> tip: root.right ? root.slot-x + Layout.tt-slot-w - 8 * Layout.u
                                      : root.slot-x + 8 * Layout.u;

    Path {
        x: root.right ? root.tip - 16 * Layout.u : root.tip;
        y: root.cy - 12 * Layout.u;
        width: 16 * Layout.u; height: 24 * Layout.u;
        viewbox-width: 16; viewbox-height: 24;
        fill: root.colour;
        MoveTo { x: root.right ? 16 : 0; y: 12; }
        LineTo { x: root.right ? 0 : 16; y: 0; }
        LineTo { x: root.right ? 0 : 16; y: 24; }
        Close { }
    }
    Rectangle {
        x: root.right ? root.tip - 30 * Layout.u : root.tip + 16 * Layout.u;
        y: root.cy - 5 * Layout.u; width: 14 * Layout.u; height: 10 * Layout.u;
        background: root.colour;
    }
}

// Low-beam headlight (low_beam_lamp): a half disc and three beams.
export component LowBeamLamp inherits Rectangle {
    in property <length> slot-x;
    in property <color> colour;

    property <length> cx: root.slot-x + 18 * Layout.u;
    property <length> cy: Layout.tt-y + Layout.tt-h / 2;

    Path {
        x: root.cx - 10 * Layout.u; y: root.cy - 10 * Layout.u;
        width: 20 * Layout.u; height: 20 * Layout.u;
        viewbox-x: -10; viewbox-y: -10; viewbox-width: 20; viewbox-height: 20;
        fill: root.colour;
        MoveTo { x: 0; y: -10; }
        ArcTo { x: 0; y: 10; radius-x: 10; radius-y: 10; sweep: false; }
        Close { }
    }
    for i in 3: Path {
        x: root.cx + 4 * Layout.u; y: root.cy + (i - 1) * 7 * Layout.u - 3 * Layout.u;
        width: 12 * Layout.u; height: 6 * Layout.u;
        viewbox-width: 12; viewbox-height: 6;
        stroke: root.colour; stroke-width: 1.6 * Layout.u;
        MoveTo { x: 0; y: 3; }
        LineTo { x: 12; y: 1; }
    }
}

// Engine (MIL) pictogram (engine_lamp): block, head, two ports, two feet.
export component EngineLamp inherits Rectangle {
    in property <length> slot-x;
    in property <color> colour;
    property <length> y0: Layout.tt-y;

    Rectangle { x: root.slot-x + 8 * Layout.u; y: root.y0 + 14 * Layout.u; width: 24 * Layout.u; height: 16 * Layout.u; border-radius: 3 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 14 * Layout.u; y: root.y0 + 8 * Layout.u; width: 12 * Layout.u; height: 7 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 3 * Layout.u; y: root.y0 + 18 * Layout.u; width: 6 * Layout.u; height: 8 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 31 * Layout.u; y: root.y0 + 18 * Layout.u; width: 8 * Layout.u; height: 8 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 12 * Layout.u; y: root.y0 + 30 * Layout.u; width: 6 * Layout.u; height: 4 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 22 * Layout.u; y: root.y0 + 30 * Layout.u; width: 6 * Layout.u; height: 4 * Layout.u; background: root.colour; }
}

// Fuel pump pictogram (fuel_lamp): body with a window, base, hose.
export component FuelLamp inherits Rectangle {
    in property <length> slot-x;
    in property <color> colour;
    property <length> y0: Layout.tt-y;

    Rectangle { x: root.slot-x + 9 * Layout.u; y: root.y0 + 6 * Layout.u; width: 17 * Layout.u; height: 26 * Layout.u; border-radius: 3 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 12 * Layout.u; y: root.y0 + 10 * Layout.u; width: 11 * Layout.u; height: 8 * Layout.u; background: Layout.bg-bottom; }
    Rectangle { x: root.slot-x + 6 * Layout.u; y: root.y0 + 32 * Layout.u; width: 23 * Layout.u; height: 3 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 28 * Layout.u; y: root.y0 + 12 * Layout.u; width: 3 * Layout.u; height: 16 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 28 * Layout.u; y: root.y0 + 26 * Layout.u; width: 7 * Layout.u; height: 3 * Layout.u; background: root.colour; }
    Rectangle { x: root.slot-x + 32 * Layout.u; y: root.y0 + 18 * Layout.u; width: 3 * Layout.u; height: 10 * Layout.u; background: root.colour; }
}
