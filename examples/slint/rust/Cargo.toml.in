# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: 2026 Signal Slot, Inc.
# Generated by CMake (configure_file); @VAR@ are substituted at configure time.
#
# The one Slint sample's staticlib (examples/slint): the meter
# cluster (cluster.slint, compiled by build.rs) drawn through Slint's FemtoVG
# OpenGL ES 2.0 renderer on YakoGL, the frame sequence (demo_vehicle at
# t = 0, two frames, then the animation) and the check (../check). The
# no_std Slint workspace (SLINT_NOSTD_DIR) and the femtovg/glow forks
# (NOSTD_PATCH_DIR) are recreated from ../../nostd's patches, outside the
# repository; the paths are injected, not committed.

[package]
name = "slint_sample"
version = "0.0.0"
edition = "2021"
build = "@CARGO_SRC@/build.rs"

[lib]
path = "@CARGO_SRC@/src/lib.rs"
crate-type = ["staticlib"]

[dependencies]
slint-check = { package = "yakogl-slint-check", path = "@SLINT_CHECK_DIR@" }
slint = { path = "@SLINT_NOSTD_DIR@/api/rs/slint", default-features = false, features = ["compat-1-2", "unsafe-single-threaded", "libm"] }
i-slint-renderer-femtovg = { path = "@SLINT_NOSTD_DIR@/internal/renderers/femtovg", default-features = false, features = ["opengl"] }
i-slint-core = { path = "@SLINT_NOSTD_DIR@/internal/core", default-features = false, features = ["libm", "unsafe-single-threaded"] }

[build-dependencies]
slint-build = { path = "@SLINT_NOSTD_DIR@/api/rs/build", default-features = false, features = ["compat-1-18", "renderer-software"] }

[profile.release]
panic = "abort"
opt-level = "z"

[profile.dev]
panic = "abort"

# Own workspace root: do not attach to any Cargo workspace above the build dir.
[workspace]

# Slint's FemtoVG renderer depends on femtovg/glow from crates.io, which are
# not no_std: redirect them to the no_std forks.
[patch.crates-io]
femtovg = { path = "@NOSTD_PATCH_DIR@/femtovg" }
glow = { path = "@NOSTD_PATCH_DIR@/glow" }
